# tests/chat-squash-publish, as an ENTRY: evaluating this directory yields the
# test's ARG TREE, which dev/run-test then runs.
#
# A WORKER TEST, like tests/chat-tools-mixed: design/stacks.md's publishing
# steps, squash-stack then publish_source, run through llm-step's real tool
# loop with a scripted model.
#
# dev/worker-test, not std/bash: the conversation REF is the completion signal,
# and refs on the server are the one thing caos gives a worker no verb for.
curry --base:@=DEEP-DEPS/worker-test --worker1:@=worker.sh --bash-tool:@=DEEP-DEPS/bash-tool --squash:@=DEEP-DEPS/squash-stack --llm-step:@=DEEP-DEPS/llm-step --stub:@=DEEP-DEPS/llm-stub --tool:@=DEEP-DEPS/llm-test-tool --common:@=DEEP-DEPS/llm-test/worker-common.sh
