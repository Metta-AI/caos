#!/usr/bin/env bash
# std/merge/worker is this script's only copy; the suite's image jobs
# (caos-tools/build/worker.sh) read it here.
# (env shebang: the flake image this defines has bash at /bin/bash, but the
# nix-builder images have only /usr/bin/env, which the flake-builder's caos
# delta guarantees — the portable meeting point, as std/bash notes.)
#
# The merge worker (SPEC "Merging and conflict resolution"). The caos runner
# execs us as /worker with the args materialized under /cas/args:
#   ours   (:commit=)  the source tree commit to merge into (the current side)
#   theirs (:commit=)  the commit to merge in
# We three-way merge them and write a single result: a two-parent commit M =
# (merged tree, parents [ours, theirs]). On conflict the merged tree carries
# git's inline markers PLUS a reserved .caos/conflicts file — git's own
# unmerged notation, which text markers cannot express for structural
# conflicts (see SPEC). M becomes the writer result's prop at /cas/out.
set -euo pipefail

# The commit args materialize as raw commit-object files; `caos hash` reads the
# recorded id without fetching content — and the id is all we need, since the
# objects themselves stay on the server.
ours=$(caos hash /cas/args/ours)
theirs=$(caos hash /cas/args/theirs)

# Both source merging and replay use the server's object-only merge endpoint.
caos git-merge-tree "$ours" "$theirs" > /tmp/merged.json
merged_tree=$(jq -r .tree /tmp/merged.json)
code=0
if [ "$(jq -r '.conflicts | length' /tmp/merged.json)" != 0 ]; then code=1; fi

caos get /cas/args/ours
timestamp=
while IFS= read -r line; do
  if [[ "$line" == committer\ * ]]; then
    timestamp=${line% *}
    timestamp=${timestamp##* }
    break
  fi
done < /cas/args/ours
: "${timestamp:?missing committer timestamp}"
mtree=$merged_tree
work=/tmp/merge-work
if [ "$code" = 1 ]; then
  caos get-hash "$merged_tree" /cas/merged
  mkdir -p "$work/.caos"
  shopt -s dotglob nullglob
  for entry in /cas/merged/*; do
    name=${entry##*/}
    if [ "$name" != .caos ]; then ln -s "$entry" "$work/$name"; fi
  done
  if [ -e /cas/merged/.caos ] && [ ! -d /cas/merged/.caos ]; then
    echo "merge: .caos must be a directory" >&2
    exit 1
  fi
  if [ -d /cas/merged/.caos ]; then
    caos get /cas/merged/.caos
    for entry in /cas/merged/.caos/*; do
      name=${entry##*/}
      if [ "$name" != conflicts ]; then ln -s "$entry" "$work/.caos/$name"; fi
    done
  fi
  jq -rj .conflicts /tmp/merged.json > "$work/.caos/conflicts"
  caos put "$work" /cas/merged-with-conflicts
  mtree=$(caos hash /cas/merged-with-conflicts)
fi

# Mint M = (merged tree, parents [ours, theirs]). Inheriting ours' timestamp
# keeps a merge of the same two commits a pure value while giving conversation
# merges a useful date. put-commit at /cas/out makes `commit <hash>` the result.
commit=/tmp/merge-commit
{
  printf 'tree %s\n' "$mtree"
  printf 'parent %s\n' "$ours"
  printf 'parent %s\n' "$theirs"
  printf 'author caos <caos@caos> %s +0000\n' "$timestamp"
  printf 'committer caos <caos@caos> %s +0000\n' "$timestamp"
  printf '\nmerge %s into %s\n' "$theirs" "$ours"
} > "$commit"
caos put-commit "$commit" /cas/mergecommit

# The writer result: `{prop, out}` (SPEC, "CaosTools"). `prop` is the COMMIT
# above rather than a tree, because a merge is the one case that needs a second
# parent -- every other writer hands back a tree and lets the harness mint.
#
# `out` IS WRITTEN HERE, not by the harness. It used to be composed in llm-step
# from `.caos/conflicts`, which meant the tool's own answer depended on who ran
# it; the same reasoning already put this tool's `help` in its `.caos-expr`.
res=/tmp/merge-result
rm -rf "$res"; mkdir -p "$res"
if [ "$code" = 1 ]; then
  # A quoted heredoc: this prose contains apostrophes and backticks, and
  # printf with single quotes turns it into unreadable '"'"' escapes.
  cat > "$res/out" <<'CONFLICTS'
merge produced conflicts. The source tree now carries git's inline conflict
markers in the affected files, plus .caos/conflicts (git's unmerged notation,
richer than markers). Resolve each path -- edit the file, reading a stage's
content with `read` (pass the stage oid as `root`) -- then delete that path's
rows from .caos/conflicts. Saving the resolution removes the empty ledger and
its .caos directory if empty. Bash edits and deletions are committed
automatically. Run relevant checks.

.caos/conflicts:
CONFLICTS
  cat "$work/.caos/conflicts" >> "$res/out"
  # A conflict is NOT a failed call: the proposal is wanted and the model is
  # being asked to finish it, so no `failed` entry.
else
  printf 'merge completed cleanly; the source tree is the merged result.\n' > "$res/out"
fi
ln -s /cas/mergecommit "$res/prop"
caos put "$res" /cas/out
