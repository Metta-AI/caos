#!/usr/bin/env bash
# Drive a Claude Code cloud session from a terminal (or another Claude session).
#
# Starting a NEW session needs a TTY -- `claude --cloud` refuses a pipe and
# would silently run locally -- so this wraps it in script(1). CONTINUING an
# existing session is `-p`, which needs no TTY. Either way the prompt is read
# from a FILE at run time and never interpolated into a command string: a
# prompt with an apostrophe, a `$(...)`, a backtick or a pipe would otherwise
# be truncated or executed by the shell building that string (measured: a
# prompt saying "each block's output" was cut at the apostrophe and the session
# received no commands at all).
#
#   drive 'a brand new session prompt'      # prints the new session id
#   drive -c session_XXXX 'a follow-up'     # inject into an existing session
#   drive -f prompt.txt                     # read the prompt from a file
#   drive -c session_XXXX -f prompt.txt     # both
#   drive --probe                           # dump the cloud env (new session)
#   drive -c session_XXXX --probe           # dump the env of a running session
#   drive --env session_XXXX                # read a session's env from OUTSIDE
#   drive --env https://claude.ai/code/...  # same, from a session URL
#   drive --conv session_XXXX               # the session's CONVERSATION on caosd
#   drive --env-config                      # LIST cloud environments (id + name)
#   drive --env-config Caos                 # print an env's setup script + vars
#   drive --env-update Caos --init-script F # replace an env's setup script
#   drive --env-update Caos --set-env K=V   # set/unset env vars (--unset-env K)
#   drive --env-create NAME --from Caos     # create (optionally cloning an env)
#   drive --env-delete NAME                 # delete an environment
#
# The --env-update/-create/-delete modes WRITE the environment over the same web
# API as --env-config (same $CLAUDE_SESSION_KEY cookie). --init-script FILE reads
# the setup script from FILE; --set-env/--unset-env edit env vars; --rename
# renames. To toggle Bash in an env, point its setup line at a script that passes
# `--enable-bash` (install.sh honours it) and re-snapshot the env.
#
# `--env-config` reads an environment DEFINITION (setup script + env vars) that
# `--env` cannot: those live behind the claude.ai WEB api, which is cookie-authed
# rather than OAuth, AND behind Cloudflare. Set $CLAUDE_SESSION_KEY (or
# $CLAUDE_SESSION_ID) to the browser's `sessionKey` cookie (Chrome DevTools >
# Application > Cookies > claude.ai > sessionKey -- it is HttpOnly, so it is NOT
# in document.cookie); the org is discovered from it, or pinned with
# $CLAUDE_ORG_ID. Requests go through curl-impersonate (a real Chrome TLS
# fingerprint) so Cloudflare does not serve its bot challenge. The env vars are
# not secrets ("visible to anyone using this environment"), so they print in full.
#
# `--env` reads a session's environment from OUTSIDE the session, over the code
# API -- no prompt, no in-container shell. It GETs the session object and its
# provisioning events and prints the environment id and kind, the container
# Claude Code version, the repo branches, the worker's tool set, the MCP config,
# the auto summary, and the env_manager_log trace (sandbox alloc, repo clone,
# mounted-vs-installed client, setup-script run). It reads the account's own
# OAuth token from ~/.claude/.credentials.json. NOTE: this API does NOT serve the
# environment DEFINITION -- the setup-script text and env-var VALUES are not
# exposed to a session-scoped token; for those, `--probe` is the only channel.
#
# `--probe` reads the ENVIRONMENT from INSIDE the session, with no dependence on
# caos being installed or healthy: it asks the session's own Claude Code to
# report the container. On any env that allows a shell (the default) it dumps
# env vars, the Claude/MCP config, installed binaries, processes, listening
# ports and the caos tunnel logs; on an env that denies the shell it falls back
# to listing the MCP servers, tools, skills and cwd it can see. The answer comes
# back in the run log, not here.
#
# Read a --probe result back with the run-log API, not this tool:
#   GET https://claude.ai/api ... or, in Claude Code, RemoteTrigger get_run_log.
set -euo pipefail

session=""
file=""
probe=0
env_read=0
conv_read=0
env_config=0
env_update=0
env_create=0
env_delete=0
session_arg=""
init_script_file=""
from_env=""
rename=""
declare -a set_env=()
declare -a unset_env=()
for ((i = 1; i <= $#; i++)); do
    case "${!i}" in
        --probe) probe=1 ;;
        --env) env_read=1 ;;
        --conv) conv_read=1 ;;
        --env-config) env_config=1 ;;
        --env-update) env_update=1 ;;
        --env-create) env_create=1 ;;
        --env-delete) env_delete=1 ;;
        --init-script) i=$((i + 1)); init_script_file="${!i}" ;;
        --from) i=$((i + 1)); from_env="${!i}" ;;
        --rename) i=$((i + 1)); rename="${!i}" ;;
        --set-env) i=$((i + 1)); set_env+=("${!i}") ;;
        --unset-env) i=$((i + 1)); unset_env+=("${!i}") ;;
        -c) i=$((i + 1)); session="${!i}" ;;
        -f) i=$((i + 1)); file="${!i}" ;;
        -*) echo "drive: unknown flag ${!i}" >&2; exit 2 ;;
        # A bare token is a prompt normally, or the session/env for --env*.
        *) file=""; prompt="${!i}"; session_arg="${!i}" ;;
    esac
done

# jq is needed by the --env* modes; prefer a PATH jq, fall back to nix.
jqf() { if command -v jq >/dev/null 2>&1; then jq "$@"; else nix run nixpkgs#jq -- "$@"; fi; }

# --- claude.ai web API, for --env-config / --env-update / --env-create /
# --env-delete. The environment API is cookie-authed (the browser's sessionKey,
# NOT the CLI's OAuth token) and Cloudflare-fronted, so requests go through
# curl-impersonate (a real Chrome TLS fingerprint) to clear the managed
# challenge -- a plain curl gets a 200 whose body is the "Just a moment..."
# interstitial -- without a browser-solved cf_clearance cookie.
_cookie="${CLAUDE_SESSION_KEY:-${CLAUDE_SESSION_ID:-}}"
web() {
    if command -v curl-impersonate-chrome >/dev/null 2>&1; then
        curl-impersonate-chrome --impersonate chrome110 --compressed -sS -m 25 -H "Cookie: sessionKey=$_cookie" "$@"
    else
        nix run nixpkgs#curl-impersonate -- --impersonate chrome110 --compressed -sS -m 25 -H "Cookie: sessionKey=$_cookie" "$@"
    fi
}
require_cookie() {
    if [ -z "$_cookie" ]; then
        echo "drive: set CLAUDE_SESSION_KEY (or CLAUDE_SESSION_ID) to your claude.ai" >&2
        echo "  'sessionKey' cookie -- DevTools > Application > Cookies > claude.ai >" >&2
        echo "  sessionKey (HttpOnly, so it is not in document.cookie)." >&2
        exit 1
    fi
}
# Every org the account belongs to (an env can live in a non-default one, so a
# single guessed org is wrong), unless $CLAUDE_ORG_ID pins one.
orgs_all() {
    if [ -n "${CLAUDE_ORG_ID:-}" ]; then printf '%s\n' "$CLAUDE_ORG_ID"
    else web "https://claude.ai/api/organizations" 2>/dev/null | jqf -r '.[].uuid // empty' 2>/dev/null; fi
}
env_base() { printf 'https://claude.ai/v1/environment_providers/private/organizations/%s' "$1"; }
# Resolve a name-or-id to "<org><TAB><env_id>" across all orgs; empty if absent.
env_locate() {
    local want="$1" o m sel
    if [ "${want#env_}" != "$want" ]; then sel='.environment_id==$v'; else sel='.name==$v'; fi
    for o in $(orgs_all); do
        m="$(web "$(env_base "$o")/environments?limit=1000" 2>/dev/null \
             | jqf -r --arg v "$want" ".environments[]? | select($sel) | .environment_id" 2>/dev/null | head -1)"
        [ -n "$m" ] && { printf '%s\t%s\n' "$o" "$m"; return 0; }
    done
    return 1
}
# Apply --init-script/--set-env/--unset-env/--rename to a full env JSON on stdin.
env_mutate() {
    local j kv k v; j="$(cat)"
    if [ -n "$init_script_file" ]; then
        j="$(printf '%s' "$j" | jqf --rawfile s "$init_script_file" '.config.init_script=$s')"
    fi
    if [ "${#set_env[@]}" -gt 0 ]; then
        for kv in "${set_env[@]}"; do k="${kv%%=*}"; v="${kv#*=}"
            j="$(printf '%s' "$j" | jqf --arg k "$k" --arg v "$v" '.config.environment[$k]=$v')"; done
    fi
    if [ "${#unset_env[@]}" -gt 0 ]; then
        for k in "${unset_env[@]}"; do
            j="$(printf '%s' "$j" | jqf --arg k "$k" 'del(.config.environment[$k])')"; done
    fi
    [ -n "$rename" ] && j="$(printf '%s' "$j" | jqf --arg n "$rename" '.name=$n')"
    printf '%s' "$j"
}
# Pretty-print a full env JSON on stdin.
env_print() {
    jqf -r '.config as $c |
      "name:    \(.name)   id: \(.environment_id)   state: \(.state)",
      "type:    \($c.environment_type)/\($c.sub_type)   cwd: \($c.cwd)",
      "network: hosts=\($c.network_config.allowed_hosts)  mcp=\($c.network_config.allow_mcp_servers)",
      "--- environment variables ---",
      (($c.environment // {}) | to_entries[] | "  \(.key)=\(.value)"),
      "--- setup / init script ---",
      ($c.init_script // "(none)")'
}

if [ "$env_config" = 1 ]; then
    require_cookie
    orgs="$(orgs_all)"
    [ -n "$orgs" ] || { echo "drive --env-config: could not resolve any org (cookie expired?); set CLAUDE_ORG_ID" >&2; exit 1; }
    if [ -z "$session_arg" ]; then
        any=0
        for o in $orgs; do
            if web "$(env_base "$o")/environments?limit=1000" 2>/dev/null \
                 | jqf -r --arg o "$o" '.environments[]? | "\(.environment_id)   \(.name)   [\(.state)]   org=\($o)"' 2>/dev/null; then any=1; fi
        done
        [ "$any" = 1 ] || { echo "drive --env-config: no environments found (cookie expired?)" >&2; exit 1; }
        exit 0
    fi
    loc="$(env_locate "$session_arg")" || { echo "drive --env-config: no environment matching '$session_arg'" >&2; exit 1; }
    o="${loc%%$'\t'*}"; eid="${loc#*$'\t'}"
    detail="$(web "$(env_base "$o")/environments/$eid" 2>/dev/null || true)"
    printf '%s' "$detail" | jqf -e '.config' >/dev/null 2>&1 \
        || { echo "drive --env-config: could not read $eid:" >&2; printf '%s' "$detail" | head -c 300 >&2; echo >&2; exit 1; }
    printf '%s' "$detail" | env_print
    exit 0
fi

if [ "$env_delete" = 1 ]; then
    require_cookie
    [ -n "$session_arg" ] || { echo "drive --env-delete: give the name or id to delete" >&2; exit 2; }
    loc="$(env_locate "$session_arg")" || { echo "drive --env-delete: no environment matching '$session_arg'" >&2; exit 1; }
    o="${loc%%$'\t'*}"; eid="${loc#*$'\t'}"
    code="$(web -o /dev/null -w '%{http_code}' -X POST "$(env_base "$o")/environments/$eid/delete" 2>/dev/null)"
    [ "$code" = 200 ] && echo "deleted $eid" || { echo "drive --env-delete: HTTP $code" >&2; exit 1; }
    exit 0
fi

if [ "$env_update" = 1 ]; then
    require_cookie
    [ -n "$session_arg" ] || { echo "drive --env-update: give the name or id to update" >&2; exit 2; }
    loc="$(env_locate "$session_arg")" || { echo "drive --env-update: no environment matching '$session_arg'" >&2; exit 1; }
    o="${loc%%$'\t'*}"; eid="${loc#*$'\t'}"
    cur="$(web "$(env_base "$o")/environments/$eid" 2>/dev/null || true)"
    printf '%s' "$cur" | jqf -e '.config' >/dev/null 2>&1 \
        || { echo "drive --env-update: could not read $eid:" >&2; printf '%s' "$cur" | head -c 300 >&2; echo >&2; exit 1; }
    # Update takes name+description+config, NOT kind (the API rejects an extra kind).
    body="$(printf '%s' "$cur" | env_mutate | jqf '{name, description:(.description // .name), config}')"
    code="$(printf '%s' "$body" | web -o /dev/null -w '%{http_code}' -X POST -H 'Content-Type: application/json' --data @- "$(env_base "$o")/environments/$eid" 2>/dev/null)"
    [ "$code" = 200 ] || { echo "drive --env-update: HTTP $code" >&2; printf '%s' "$body" | head -c 200 >&2; echo >&2; exit 1; }
    echo "updated $eid:"
    web "$(env_base "$o")/environments/$eid" 2>/dev/null | env_print
    exit 0
fi

if [ "$env_create" = 1 ]; then
    require_cookie
    [ -n "$session_arg" ] || { echo "drive --env-create: give a name (and optionally --from <env> to clone)" >&2; exit 2; }
    org="${CLAUDE_ORG_ID:-$(orgs_all | head -1)}"
    if [ -n "$from_env" ]; then
        loc="$(env_locate "$from_env")" || { echo "drive --env-create: --from '$from_env' not found" >&2; exit 1; }
        org="${loc%%$'\t'*}"; fid="${loc#*$'\t'}"
        seed="$(web "$(env_base "$org")/environments/$fid" 2>/dev/null)"
    else
        seed='{"config":{"environment_type":"anthropic","sub_type":"ccr","cwd":"/home/user","init_script":"","environment":{},"languages":[{"name":"python","version":"3.11"},{"name":"node","version":"20"}],"network_config":{"allowed_hosts":["*"],"allow_default_hosts":true,"allow_mcp_servers":true}}}'
    fi
    rename="$session_arg"   # env_mutate uses $rename to set the new name
    body="$(printf '%s' "$seed" | env_mutate | jqf '{name, kind:"anthropic_cloud", description:(.description // "created by drive"), config}')"
    resp="$(printf '%s' "$body" | web -X POST -H 'Content-Type: application/json' --data @- "$(env_base "$org")/cloud/create" 2>/dev/null)"
    printf '%s' "$resp" | jqf -e '.environment_id' >/dev/null 2>&1 \
        || { echo "drive --env-create: failed:" >&2; printf '%s' "$resp" | head -c 300 >&2; echo >&2; exit 1; }
    echo "created $(printf '%s' "$resp" | jqf -r '.environment_id') ($session_arg)"
    printf '%s' "$resp" | env_print
    exit 0
fi

# `--conv` finds the CONVERSATION a session is recording into, on the caos
# server, and prints enough to read its tree by hand.
#
# THE ID IS NOT THE ONE IN THE URL. A conversation is `cc/<the Claude Code
# INTERNAL session uuid>`, which appears only in hook payloads, and the ref
# spells that HEX-ENCODED -- so neither the session id you can see nor a plain
# grep of the refs will find it.
#
# Why bother: the conversation tree is the one place that says what a session
# actually evaluates. A checkout can be rewritten (dev mode rewrites
# `.caos-expr`) while the conversation still carries the committed file, and
# from inside the session the two are indistinguishable -- `mcp__caos__read`
# shows the conversation's copy, which is the one that matters and the one
# nobody thinks to doubt.
if [ "$conv_read" = 1 ]; then
    sid="$(printf '%s' "${session:-$session_arg}" | grep -oE 'session_[A-Za-z0-9]+' | head -1 || true)"
    if [ -z "$sid" ]; then
        echo "drive --conv: need a session id or a claude.ai/code URL with one" >&2
        exit 2
    fi
    token="$(jqf -r '.claudeAiOauth.accessToken // empty' "$HOME/.claude/.credentials.json" 2>/dev/null || true)"
    api="https://api.anthropic.com/v1/code/sessions/$sid"
    hdr=(-H "Authorization: Bearer $token"
         -H "anthropic-beta: oauth-2025-04-20"
         -H "anthropic-version: 2023-06-01")
    internal="$(curl -sS -m 20 "${hdr[@]}" "$api/events" 2>/dev/null \
        | jqf -r '(.data // []) | map(select(.payload.session_id)) | .[0].payload.session_id // empty')"
    if [ -z "$internal" ]; then
        echo "drive --conv: no hook payload in $sid yet, so no internal session id." >&2
        echo "  A session that has not run a turn has no conversation." >&2
        exit 1
    fi
    hex="$(printf 'cc/%s' "$internal" | od -An -tx1 | tr -d ' \n')"
    ref="refs/caos/v3/conversations/$hex/head"
    server="${CAOS_SERVER_URL:-http://localhost:9090}"
    echo "session:      $sid"
    echo "internal id:  $internal"
    echo "conversation: cc/$internal"
    echo "ref:          $ref"
    head="$(git ls-remote "$server" "$ref" 2>/dev/null | awk '{print $1}')"
    if [ -z "$head" ]; then
        echo "head:         (not on $server -- wrong server, or no turn yet)"
        exit 1
    fi
    echo "head:         $head"
    cat <<NOTE

Read its tree in a SCRATCH BARE REPO -- never your working checkout. A
\`--depth=1\` fetch into a repo you push from records a shallow boundary, and
this server refuses shallow pushes ("shallow pushes are not accepted"), so
every later push from that checkout dies for an unrelated-looking reason.

  git init -q --bare /tmp/conv.git
  git -C /tmp/conv.git fetch -q --depth=1 $server $head
  git -C /tmp/conv.git ls-tree $head
  git -C /tmp/conv.git cat-file blob <blob-sha>       # e.g. .caos-expr

Every conversation, with the names decoded:

  git ls-remote $server 'refs/caos/v3/conversations/*' |
    while read -r sha ref; do
      hex=\$(echo "\$ref" | cut -d/ -f5)
      echo "\$sha \$(echo "\$hex" | fold -w2 | while read -r b; do printf "\\x\$b"; done)"
    done
NOTE
    exit 0
fi

if [ "$env_read" = 1 ]; then
    sid="$(printf '%s' "${session:-$session_arg}" | grep -oE 'session_[A-Za-z0-9]+' | head -1 || true)"
    if [ -z "$sid" ]; then
        echo "drive --env: need a session id or a claude.ai/code URL with one" >&2
        exit 2
    fi
    token="$(jqf -r '.claudeAiOauth.accessToken // empty' "$HOME/.claude/.credentials.json" 2>/dev/null || true)"
    if [ -z "$token" ]; then
        echo "drive --env: no OAuth token in ~/.claude/.credentials.json" >&2
        exit 1
    fi
    api="https://api.anthropic.com/v1/code/sessions/$sid"
    hdr=(-H "Authorization: Bearer $token"
         -H "anthropic-beta: oauth-2025-04-20"
         -H "anthropic-version: 2023-06-01")
    sess="$(curl -sS -m 20 "${hdr[@]}" "$api" 2>/dev/null || true)"
    if ! printf '%s' "$sess" | jqf -e '.response_shape' >/dev/null 2>&1; then
        echo "drive --env: could not read session $sid (token expired? re-login):" >&2
        printf '%s' "$sess" | head -c 300 >&2; echo >&2
        exit 1
    fi
    printf '%s' "$sess" | jqf -r '.response_shape as $s |
      "session:        \($s.id)   status: \($s.status)  (\($s.status_bucket))",
      "title:          \($s.title)",
      "environment:    \($s.environment_id)  (\($s.environment_kind))",
      "container cc:   \($s.external_metadata.container_cc_version)",
      "branches:       \($s.external_metadata.current_branches)",
      "worker tools:   \(($s.external_metadata.turn_handoff.tools // []) | join(", "))",
      "config model:   \($s.config.model)   origin: \($s.config.origin)",
      "config sources: \($s.config.sources)   mcp connectors: \($s.config.mcp_connector_ids)",
      "summary:        \($s.post_turn_summary.recent_action)",
      "                \($s.post_turn_summary.status_detail)"'
    echo "--- provisioning (env_manager_log, oldest first) ---"
    curl -sS -m 20 "${hdr[@]}" "$api/events" 2>/dev/null \
      | jqf -r '(.data // .events // []) | map(select(.event_type=="env_manager_log"))
                | sort_by(.sequence_num|tonumber)[]
                | "  [\(.payload.data.level)] \(.payload.data.content)"' 2>/dev/null \
      || echo "  (no env_manager_log events)"
    exit 0
fi

# The prompt lands in a temp file whether it came as an argument, a path, or the
# built-in probe, so the launch below has exactly one shape to get right.
tmp="$(mktemp)"
trap 'rm -f "$tmp"' EXIT
if [ "$probe" = 1 ]; then
    # The probe is a STANDALONE prompt: it names no caos config and assumes
    # nothing is installed, so it reads a plain cloud env as readily as a caos
    # one. The embedded script runs in ONE shell call and brackets its output so
    # the reader can lift it out of the transcript; the no-shell branch keeps the
    # probe useful on an env whose settings deny Bash (e.g. the caos deny list).
    cat > "$tmp" <<'PROBE'
Report the ENVIRONMENT of this cloud container verbatim -- do not summarize or
interpret, I need the raw facts.

If you have a Bash/shell tool: run the single script below in ONE Bash call and
paste its entire stdout+stderr, unedited, between the BEGIN/END markers it
prints.

If you do NOT have a Bash tool: say so plainly, then between markers
`===== CAOS-ENV-REPORT BEGIN =====` and `===== CAOS-ENV-REPORT END =====`
report instead (a) every MCP server and every tool you can find (search the tool
registry broadly, several queries), (b) any skills and connectors, (c) your
current working directory and model, and (d) anything else observable about the
environment. Do not stop at the first search.

------------------------------- run this -------------------------------
{
echo "===== CAOS-ENV-REPORT BEGIN ====="
echo "## identity"
uname -a; echo "user=$(whoami) uid=$(id -u) cwd=$(pwd) HOME=$HOME shell=$SHELL"
echo "## env (values of SECRET/TOKEN/KEY/PASSWORD/PAT/CRED vars masked)"
env | sort | awk -F= '{k=$1; v=substr($0,length(k)+2);
  if (k ~ /SECRET|TOKEN|KEY|PASSWORD|CRED/ || k ~ /(^|_)PAT(_|$)/) printf "%s=<redacted len=%d>\n",k,length(v);
  else print}'
echo "## caos + tunnel install"
ls -la /usr/local/bin 2>/dev/null | grep -iE 'caos|dumbpipe' || echo "(none in /usr/local/bin)"
for b in caos caos-serve dumbpipe; do printf '%s: ' "$b"; command -v "$b" || echo "(absent)"; done
caos --version 2>&1 | head -1
echo "-- build record --"; cat /usr/local/share/caos/build 2>/dev/null || echo "(none)"
echo "-- setup stamp --"; cat /usr/local/share/caos/setup-stamp 2>/dev/null || echo "(none)"
echo "## session-start bootstrap (first 40 lines)"
cat /usr/local/bin/caos-cloud-session-start 2>/dev/null | head -40 || echo "(none)"
echo "## claude / mcp config"
for f in "$HOME/.claude/settings.json" "$HOME/.claude.json" "$HOME/.mcp.json" ".claude/settings.json" ".mcp.json"; do
  echo "-- $f --"
  if [ -f "$f" ]; then
    case "$f" in
      *.claude.json) jq '{mcpServers}' "$f" 2>/dev/null || grep -aA40 mcpServers "$f" || echo "(unreadable)";;
      *) cat "$f";;
    esac
  else echo "(absent)"; fi
done
echo "## processes"
ps -eo pid,ppid,pgid,sess,etime,args 2>/dev/null | grep -iE 'caos|dumbpipe|mcp serve' | grep -v grep || echo "(none)"
echo "## listening tcp (hex local addr:port, state 0A=LISTEN)"
awk 'NR>1 && $4=="0A"{print $2}' /proc/net/tcp 2>/dev/null; awk 'NR>1 && $4=="0A"{print $2}' /proc/net/tcp6 2>/dev/null
echo "## tunnel / warm logs"
for l in /tmp/caos-tunnel.log /tmp/caos-tunnel2.log /tmp/caos-warm.log; do echo "-- $l --"; cat "$l" 2>/dev/null || echo "(none)"; done
echo "## caos server reachability"
url="${CAOS_SERVER_URL:-}"; [ -z "$url" ] && url="$(git config --get remote.caos.url 2>/dev/null || true)"
echo "caos remote/url: ${url:-<none found>}"
[ -n "$url" ] && curl -sS -m 8 -o /dev/null -w "  $url -> HTTP %{http_code} in %{time_total}s\n" "$url" 2>&1 || echo "  (no url to probe)"
echo "===== CAOS-ENV-REPORT END ====="
} 2>&1
--------------------------------- end ----------------------------------

Paste everything from `===== CAOS-ENV-REPORT BEGIN =====` through
`===== CAOS-ENV-REPORT END =====` verbatim, then stop.
PROBE
elif [ -n "$file" ]; then
    cat "$file" > "$tmp"
elif [ -n "${prompt:-}" ]; then
    printf '%s' "$prompt" > "$tmp"
else
    cat > "$tmp"   # from stdin
fi
if ! [ -s "$tmp" ]; then
    echo "drive: empty prompt" >&2
    exit 2
fi

if [ -n "$session" ]; then
    # Continue: no TTY needed. `-p` posts a message into the running session.
    claude --cloud "$session" -p "$(cat "$tmp")"
else
    # Start: `--cloud` needs a TTY, so run it under script(1). The prompt is
    # read inside the single-quoted -c string, so nothing in it is parsed by
    # the shell that assembles the command.
    out="$(mktemp)"
    trap 'rm -f "$tmp" "$out"' EXIT
    CAOS_DRIVE_PROMPT="$tmp" \
        script -qec 'claude --cloud "$(cat "$CAOS_DRIVE_PROMPT")"' "$out" >/dev/null 2>&1 || true
    # The banner carries the session id; surface it and the whole banner.
    sed -n 's/.*\(session_[A-Za-z0-9]*\).*/\1/p' "$out" | head -1
    grep -aE 'session_|View:|Resume' "$out" >&2 || true
fi
