#!/usr/bin/env bash
# THE caos stack (design/one-stack-image.md): start the daemon group, wait
# until it is serving, then supervise it. This is the one bring-up in the
# tree — `caosd serve` is this script, and every placement runs it:
#
#   dev    dev/stack-up starts it inside a caos worker, runs the suite on it,
#          and dies with that worker (dev/stack-up)
#   host   `caosd up` runs the stack image with this as its command
#   seed   the flake's seed derivation runs it to publish std
#
# The container is the CALLER's decision, not this script's. It configures
# itself from the environment and nothing else, so it is correct wherever it
# is put — which is the whole point: there is no second bring-up to drift
# against.
#
# DIES AS A GROUP. A half-dead stack is not something anyone should have to
# diagnose, so any member's death takes the rest down and exits non-zero.
# Callers that need to keep working (the dev placement) run this in the
# background and watch both the ready file and this process.
#
# Configuration, all environment:
#   CAOS_STACK_STATE   dir holding the server's git repo (required)
#   CAOS_STACK_LOGS    dir for <member>.log (required)
#   CAOS_STACK_READY   file to touch once every member is serving (optional)
#   CAOS_STACK_BIN     dir holding `server` and `runnerd` (required)
#   CAOS_STACK_REDIS_PORT     redis port (required)
#   CAOS_STACK_REDIS_PERSIST  "yes" for an appendonly cache, "no" to keep it
#                             in memory and lose it with the process
#   CAOS_STACK_REDIS_MAXMEM   redis memory cap (default 2gb). The cache is
#                             allkeys-lru, so this is a cap on the SUM of the
#                             server's results and whatever workers cache here.
#                             With PERSIST=yes it also bounds the AOF, which
#                             nothing else does — a worker's cache is written
#                             there durably and no worker cleans up after
#                             itself.
#   CAOS_STACK_REGISTRY       "yes" to run a registry in the group, "no" to use
#                             someone else's. The host placement runs one; the
#                             test placement deliberately does not — a
#                             content-addressed registry shared across tests
#                             cannot leak behaviour, only work, and sharing it
#                             is what stops every test rebaking the toolchain.
#   CAOS_STACK_REDIS          "yes" to run redis in the group, "no" to use
#                             someone else at CAOS_STACK_REDIS_ADDR. Two redis
#                             servers cannot share a DIRECTORY, so stacks that
#                             want one cache share the PROCESS and keep their
#                             entries apart with CAOS_CACHE_NAMESPACE.
#   CAOS_STACK_REDIS_ADDR     where redis is, when this group does not run one
#   CAOS_CACHE_NAMESPACE      prefix for this stack's cache keys, so sharing a
#                             redis does not mean sharing answers. Identifies
#                             the BUILD: see server Config::cache_namespace.
#   CAOS_STACK_RUNNERD        "yes" to run runnerd, "no" for a placement that
#                             dispatches no jobs. The seed is the "no": it only
#                             PUBLISHES, and build-builtins.sh runs no workers,
#                             which is what makes the seed legal inside the
#                             flake-builder container (it holds no engine socket
#                             grant, and does not need one).
#   CAOS_STACK_PUBLISH        "yes" to publish std into this stack once the
#                             server and registry are up — build-builtins.sh,
#                             run HERE and nowhere else. This is the only
#                             publish in the tree, and it is here because its
#                             output (the seed tree) is what the seeder below
#                             needs: adjacent lines, a value between them, no
#                             name in the middle for anyone else to write.
#   CAOS_STACK_PUBLISH_SCRIPT the build-builtins.sh to run (required when
#                             PUBLISH=yes). Its DIRECTORY is the tree it
#                             publishes from — build-builtins `cd`s to its own
#                             dirname — so this names both at once. Its own
#                             environment (CAOS_CLI, CAOS_BUILTIN_IMAGES,
#                             CAOS_BUILTIN_BINS, CAOS_CLIENT_REPO,
#                             CAOS_REGISTRY_HTTP) is inherited from ours;
#                             CAOS_SERVER_URL is not, because this script knows
#                             where its own server is.
#   CAOS_STACK_SEEDER         "yes" to run the core-seeder-runner (the bootstrap
#                             answerer, design/caos-expr.md Phase 3), "no"/unset
#                             otherwise. It answers seeded arg-tree keys from
#                             the seed tree, spawning no container. Default off:
#                             the seed placement only PUBLISHES.
#   CAOS_SEED_TREE            the tree of seed records the seeder answers from.
#                             Normally produced by the publish above; settable
#                             directly for a placement that seeds without
#                             publishing. Required when SEEDER=yes.
#   CAOS_STACK_SEED_GIT       optional: a prebuilt server repo to start from.
#                             std published at image build time rides in the
#                             image as one of these (design/one-stack-image.md,
#                             "The seed"), so a fresh stack has std without
#                             publishing it.
#   CAOS_RUNNER_SLOTS         the general pool's concurrency
#   CAOS_PENDING_TIMEOUT_SECS how long a job waits for a runner to exist
#   CAOS_STACK_IROH           "yes" to answer `caos://` clients as well
#                             (design/iroh-transport.md): an iroh endpoint that
#                             splices HTTP streams to this server and serves git
#                             from its object database, so a client anywhere
#                             reaches it with a TICKET and no address. Default
#                             off — it makes this stack reachable from outside
#                             the machine, which is a choice, not a default.
#   CAOS_STACK_IROH_STATE     dir holding its `key`, `token` and published
#                             `ticket` (default $CAOS_STACK_STATE/iroh). Keeping
#                             it is what keeps one ticket valid across restarts.
#   CAOS_STACK_IROH_ADVERTISE space-separated host:port addresses to put in the
#                             ticket INSTEAD of the ones the endpoint finds for
#                             itself. REQUIRED IN PRACTICE for a listener in a
#                             container: it discovers only its own address on the
#                             container network, which nothing outside can route
#                             to, while the address that reaches it is the host's
#                             with the published port. A client that cannot use
#                             any of these falls back to the relay and works,
#                             slowly — one round trip to the relay per request.
#   CAOS_STACK_HERMES         "yes" (the default) to bundle a Hermes gateway
#                             (hermes-agent) alongside this stack's own server
#                             -- one per stack, so CAOS_MCP_DEFAULT_SERVER is
#                             always just this stack's own $SERVER_URL, no
#                             ticket or address to copy in by hand. "no" for a
#                             placement with no use for one (the dev test
#                             placement defaults it off itself -- its devbox
#                             image does not carry the `hermes` binary).
#   CAOS_STACK_HERMES_PROFILE path to the hermes-profile build product
#                             (.#caos-stack-inputs's sibling of bin/images,
#                             i.e. integrations/hermes/ as ordinary nix build
#                             output, not a path into any source tree this
#                             container may not have). Required when
#                             CAOS_STACK_HERMES=yes.
#   CAOS_STACK_HERMES_PORT    port the gateway binds (default 9119, hermes's
#                             own default), loopback-only -- its own auth gate
#                             is off (see the `CAOS_STACK_HERMES=yes` block in
#                             the body), so the ONLY way in from outside this
#                             container is the iroh bridge below
#                             (`dumbpipe listen-tcp`/`connect-tcp`, a stock
#                             binary on both ends) -- never through the main
#                             caos-iroh endpoint's own request-line protocol.
#   CAOS_STACK_HERMES_DEFAULT_TOOLS
#                             yes|no, default yes. Whether the root `default`
#                             profile ALSO gets caos's own MCP tools (not just
#                             its toolset ban, which is unconditional either
#                             way) -- `hermes serve` can't be forced to route
#                             a connecting client onto the named `caos`
#                             profile (Hermes refuses to let ANY distribution
#                             install itself as `default`), so a client that
#                             never adds `?profile=caos` otherwise got a
#                             crippled, tool-less profile instead. Set to `no`
#                             to go back to that old behavior if ever wanted.
#   CAOS_STACK_HERMES_OIDC_ISSUER / _CLIENT_ID / _CLIENT_SECRET
#                             NOT currently wired up, and currently moot: the
#                             gateway's own login (`basic`/`nous`, below) never
#                             engages at all while it's loopback-only. Kept for
#                             a future local-debugging mode that puts the bind
#                             back on 0.0.0.0; `self_hosted` OIDC
#                             (a real IdP: Authentik, Keycloak, Okta, Google,
#                             ...) is still an option later if a bare Nous
#                             account isn't the right identity source -- these
#                             three env vars are reserved for that, unused.
#   CAOS_STACK_HERMES_REV     commit sha (already pushed to
#                             github:Metta-AI/caos) to pin the gateway's
#                             --llm-step to -- its build product carries no
#                             .git for caos-mcp-launch to rev-parse itself.
#                             Baked in by the caller from `self.rev or
#                             self.dirtyRev`, the same source CAOS_REV uses.
#   CAOS_STACK_HERMES_BIN     override for the `hermes` binary name/path
#                             (default: `hermes` on PATH)
#   CAOS_STACK_IROH_HERMES_STATE / _PORT
#                             the hermes bridge's own state dir (default
#                             $CAOS_STACK_STATE/iroh-hermes -- mirrors the
#                             main caos-iroh endpoint's own $IROH_STATE
#                             layout: a persisted `secret` file (dumbpipe's
#                             IROH_SECRET, so the ticket survives a restart)
#                             and a `ticket` file holding the current
#                             connect-tcp ticket, pulled out of dumbpipe's
#                             own stderr since it has no --ticket-file of
#                             its own) and UDP port
#                             (default 11205 -- the main caos-iroh endpoint's
#                             own 11204 is a DIFFERENT endpoint and cannot
#                             share it). Only started when CAOS_STACK_HERMES=
#                             yes; does NOT depend on CAOS_STACK_IROH, since
#                             it is a separate, independent `dumbpipe`
#                             endpoint, not a feature of caos-iroh's own.
#                             No _ADVERTISE: dumbpipe has no such flag, and
#                             relies on dialing through its relay same as any
#                             ordinary iroh endpoint would.
#
# Passed through to runnerd untouched, because they are the caller's business:
# DOCKER_HOST (which engine), CAOS_DOCKER_NETWORK (which netns workers join),
# CAOS_RUNNER_SOCKET (the socket this pool MAY grant, per-image).
set -euo pipefail

: "${CAOS_STACK_STATE:?serve needs CAOS_STACK_STATE}"
: "${CAOS_STACK_LOGS:?serve needs CAOS_STACK_LOGS}"
: "${CAOS_STACK_BIN:?serve needs CAOS_STACK_BIN}"
: "${CAOS_STACK_REDIS_PORT:?serve needs CAOS_STACK_REDIS_PORT}"
: "${CAOS_STACK_REDIS_PERSIST:?serve needs CAOS_STACK_REDIS_PERSIST (yes|no)}"
: "${CAOS_STACK_REGISTRY:?serve needs CAOS_STACK_REGISTRY (yes|no)}"
: "${CAOS_STACK_REDIS:?serve needs CAOS_STACK_REDIS (yes|no)}"
: "${CAOS_STACK_RUNNERD:?serve needs CAOS_STACK_RUNNERD (yes|no)}"

# The server self-bootstraps an empty repo on first boot, but the directory
# has to be there for it to bootstrap into.
mkdir -p "$CAOS_STACK_STATE/git" "$CAOS_STACK_LOGS"

# A seeded repo, if this placement ships one: the test stack's std is
# published once per tree, at image build time, rather than once per test
# (design/one-stack-image.md, "The seed"). HEAD is the probe because that is
# what the server's own `gix::open` check turns on — no HEAD, no repo — and
# only an ABSENT repo is seeded: a persistent stack's own is the newer truth.
#
# `cp -RL`, and the L is load-bearing. An image built by dockerTools lays its
# contents down as an lndir SYMLINK FARM, so every file here is a link into
# /nix/store. Copying those verbatim gives a repo whose HEAD is a symlink, and
# git's validate_headref only accepts a symlinked HEAD when the target starts
# with `refs/` — so `git -C <dir> config` reports "not in a git directory" and
# every request answers "Not a git repository", while gix opens it happily and
# the server comes up anyway. Dereference, and the copy is real files the
# server can also write to (hence the chmod: the store is read-only).
if [ -n "${CAOS_STACK_SEED_GIT:-}" ] && [ ! -e "$CAOS_STACK_STATE/git/HEAD" ]; then
  echo "caosd serve: seeding the server repo from $CAOS_STACK_SEED_GIT" >&2
  cp -RL "$CAOS_STACK_SEED_GIT/." "$CAOS_STACK_STATE/git/"
  chmod -R u+w "$CAOS_STACK_STATE/git"
fi

# The server always listens on :80. Where REDIS reaches is a placement's choice:
# loopback when this group runs its own, and someone else's address when
# CAOS_STACK_REDIS=no.
#
# A placement that DOESN'T run one is not an optimization. Two redis servers
# cannot share a directory — both start, neither locks, and they interleave one
# AOF between two disagreeing datasets (measured) — so several stacks that want
# one cache have to share a redis PROCESS, not a redis DIRECTORY. What keeps
# their entries apart there is CAOS_CACHE_NAMESPACE, not separate storage.
SERVER_URL=http://127.0.0.1
REDIS_ADDR=${CAOS_STACK_REDIS_ADDR:-127.0.0.1:$CAOS_STACK_REDIS_PORT}
# Computed here, ahead of both the iroh and the hermes blocks below: the
# hermes-only iroh relay (below, not the main caos-iroh listener's own
# protocol) needs this port before the hermes member has started (no
# liveness check at listen-time, so the ordering is fine), and the hermes
# block needs the SAME value the relay was told to splice to.
HERMES_PORT=${CAOS_STACK_HERMES_PORT:-9119}

pids=()
names=()

fail() {
  echo "caosd serve: $*" >&2
  exit 1
}

# Write (or rewrite) a hermes profile's own CAOS_* env file, preserving any
# OTHER lines already there -- a model credential added via `hermes model`/
# the dashboard's Keys UI (ANTHROPIC_API_KEY, OPENROUTER_API_KEY, etc.), or
# (for the root profile's own .env) HERMES_DASHBOARD_OAUTH_CLIENT_ID written
# by `hermes dashboard register`. This used to overwrite each file wholesale
# every `caosd up`, silently erasing them -- confirmed the hard way: a
# manually added ANTHROPIC_API_KEY vanished on the very next restart, with
# nothing in any log naming .env as the cause, only a brand new chat
# reporting "no providers". One function, called for BOTH profiles/caos/.env
# and (when CAOS_STACK_HERMES_DEFAULT_TOOLS=yes) the root .env, since both
# need the identical CAOS_* values to resolve config.yaml's own ${VAR}
# substitutions for mcp_servers.caos.
write_caos_env_file() { # <path>
  local target=$1 extra=""
  if [ -f "$target" ]; then
    extra=$(grep -v '^\(CAOS_HERMES_DIST_DIR\|CAOS_BIN\|CAOS_MCP_DEFAULT_SERVER\|CAOS_LLM_STEP_REV\|SSL_CERT_FILE\|NIX_SSL_CERT_FILE\)=' "$target" || true)
  fi
  # CAOS_BIN points at caos-cli, NOT caos: $CAOS_STACK_BIN/caos is the
  # WORKER-side binary (CAS get/put/curry/runner, no `mcp` subcommand at
  # all) -- caos-mcp-launch needs caos-cli, which carries `mcp serve`.
  # Confirmed the hard way: pointed at plain `caos`, every MCP call failed
  # "Connection closed" after `caos` printed its own usage text and exited 1
  # on the unrecognized `mcp` verb -- nothing in that failure named
  # "caos-cli" or "wrong binary" at all.
  #
  # SSL_CERT_FILE/NIX_SSL_CERT_FILE: Hermes does NOT pass its own shell
  # environment to an MCP subprocess, only a fixed safe-baseline allowlist
  # (PATH, HOME, USER, LANG, LC_ALL, TERM, SHELL, TMPDIR, XDG_*) plus
  # whatever this distribution's mcp_servers.caos.env names explicitly --
  # neither SSL var is on that baseline. caos-mcp-launch's --llm-step
  # resolution now needs `git ls-remote https://github.com/...` (the
  # caos-session/main fallback), and this image's git is a nix build that
  # trusts no CA bundle unless told one. Confirmed the hard way: the exact
  # same `git ls-remote` succeeded by hand (inheriting this shell's own
  # env) and failed under the MCP subprocess's filtered env with "SSL
  # certificate ... unable to get local issuer certificate" -- surfaced by
  # caos-mcp-launch only as a generic "ls-remote failed, which usually
  # means no network reach", which it is not. Set from THIS process's own
  # env, not hardcoded: it is already correct here (set by the stack
  # image), and a hardcoded path would be wrong for any future non-Nix or
  # non-Linux image.
  #
  # NO COMMENTS in the heredoc below: this file is rewritten every
  # `caosd up`, and the preserve-filter above only strips lines matching
  # `^KEY=` -- a comment line would never match, so it would ride along in
  # `extra` untouched while the heredoc wrote a fresh copy of the same
  # comment right above it, duplicating on every single restart. Confirmed
  # the hard way: ten-plus stacked copies of this very comment block after
  # a handful of `caosd up` runs, found by inspecting .env directly.
  {
    cat <<HERMESENV
CAOS_HERMES_DIST_DIR=$CAOS_STACK_HERMES_PROFILE
CAOS_BIN=$CAOS_STACK_BIN/caos-cli
CAOS_MCP_DEFAULT_SERVER=$SERVER_URL
CAOS_LLM_STEP_REV=${CAOS_STACK_HERMES_REV:-}
SSL_CERT_FILE=${SSL_CERT_FILE:-}
NIX_SSL_CERT_FILE=${NIX_SSL_CERT_FILE:-}
HERMESENV
    if [ -n "$extra" ]; then
      printf '%s\n' "$extra"
    fi
  } >"$target"
}

# A REQUESTED shutdown, as opposed to a member dying: take the group down and
# exit 0. Without this, killing serve orphans redis and the server — they are
# children of this shell, not of its caller — and the seed derivation would
# copy a git dir still open by a live server.
shutdown() {
  kill "${pids[@]}" 2>/dev/null || true
  wait 2>/dev/null || true
  exit 0
}
trap shutdown TERM INT

# Start a member, remember it, and name it for the supervisor's diagnostics.
start() { # <name> <command...>
  local name=$1
  shift
  "$@" >"$CAOS_STACK_LOGS/$name.log" 2>&1 &
  pids+=("$!")
  names+=("$name")
}

# --- redis: the result cache, and workers' own scratch cache -----------------
# `--protected-mode no` because this redis is no longer only the server's. A
# worker may use it too (ccache's redis backend, say), and on the HOST a worker
# has its own netns on the bridge — so it arrives from a non-loopback address,
# which protected mode refuses. Where workers share a stack's netns they reach
# it on loopback instead, so the flag is inert there.
#
# Bounded, and `allkeys-lru` rather than `volatile-lru`, because the tenant that
# forced the question cannot set a TTL: ccache's redis backend has no TTL and no
# key prefix, and its own manual says it never cleans up and to configure LRU
# eviction instead. `volatile-lru` would therefore evict NOTHING — neither
# ccache's keys nor caos's, which are written with a bare SET and no expiry
# (server/compute.rs `cache_set`) — and writes would start failing OOM at the
# cap instead. So both tenants are evictable, which is safe but not free: an
# evicted `caos:result:` key is a rebuild, so a ccache run big enough to fill
# this cap costs caos memoization. Raise CAOS_STACK_REDIS_MAXMEM before blaming
# the scheduler for work you thought was cached.
if [ "$CAOS_STACK_REDIS" = yes ]; then
redis_args=(
  --port "$CAOS_STACK_REDIS_PORT"
  --protected-mode no
  --maxmemory "${CAOS_STACK_REDIS_MAXMEM:-2gb}"
  --maxmemory-policy allkeys-lru
)
if [ "$CAOS_STACK_REDIS_PERSIST" = yes ]; then
  # appendonly keeps it durable to a hard kill, not just a clean shutdown-save.
  redis_args+=(--dir "$CAOS_STACK_STATE/redis" --appendonly yes)
  mkdir -p "$CAOS_STACK_STATE/redis"
else
  # No persistence: the cache starts empty and dies with this process. The
  # incrementality tests assert real memoization, so a cache that outlives a
  # test's stack would poison them.
  redis_args+=(--save '')
fi
start redis redis-server "${redis_args[@]}"
# Polled tightly, not politely. Every wait in this file is on the critical path
# of a bring-up, and a bring-up is on the critical path of a cold test stack
# (design/faster-tests.md) — redis answers in tens of milliseconds, so a 0.5s
# step spends most of its time asleep after the thing it waits for is ready.
for _ in $(seq 1 200); do
  redis-cli -p "$CAOS_STACK_REDIS_PORT" ping >/dev/null 2>&1 && break
  sleep 0.05
done
redis-cli -p "$CAOS_STACK_REDIS_PORT" ping >/dev/null 2>&1 \
  || fail "redis never came up"
else
  # Someone else's. Probed anyway, and by ADDRESS rather than by starting one:
  # a stack whose cache is unreachable still works (the server treats redis as
  # best-effort and runs uncached), but it works slowly and silently, and the
  # cause is far from the symptom.
  redis-cli -u "redis://$REDIS_ADDR" ping >/dev/null 2>&1 \
    || fail "CAOS_STACK_REDIS=no, but nothing answers at $REDIS_ADDR"
fi

# --- registry: the image cache, when this placement owns one -----------------
if [ "$CAOS_STACK_REGISTRY" = yes ]; then
  mkdir -p "$CAOS_STACK_STATE/registry"
  cat > "$CAOS_STACK_STATE/registry.yml" <<YML
version: 0.1
storage:
  filesystem:
    rootdirectory: $CAOS_STACK_STATE/registry
http:
  addr: :5000
YML
  start registry registry serve "$CAOS_STACK_STATE/registry.yml"
  ok=""
  for _ in $(seq 1 30); do
    # -s, not -sS: every attempt before the registry is listening would
    # otherwise print a connection error, and a retry loop's noise reads like
    # a failure in the logs the FIRST real failure dumps.
    if curl -s -o /dev/null "http://127.0.0.1:5000/v2/"; then ok=1; break; fi
    sleep 1
  done
  [ -n "$ok" ] || fail "registry never came up"
fi

# --- server ------------------------------------------------------------------
start server env \
  CAOS_GIT_DIR="$CAOS_STACK_STATE/git" \
  CAOS_REDIS_ADDR="$REDIS_ADDR" \
  CAOS_CACHE_NAMESPACE="${CAOS_CACHE_NAMESPACE:-}" \
  CAOS_PENDING_TIMEOUT_SECS="${CAOS_PENDING_TIMEOUT_SECS:-900}" \
  "$CAOS_STACK_BIN/server"
ok=""
# `git ls-remote`, NOT curl: this script also runs in the seed placement,
# whose image is the BUILDER, and that flake has no curl — a curl probe here is
# exit 127 on every attempt, so the loop runs out and every seed stack dies with
# "server never came up". (The registry probe above may use curl only because
# it sits behind CAOS_STACK_REGISTRY=yes, which is the host placement alone.)
# The 0.1s step is still worth having, for the same reason as redis above: the
# server answers in well under a second, and a 1s step meant a bring-up usually
# paid most of a second for nothing.
for _ in $(seq 1 300); do
  if git ls-remote "$SERVER_URL" >/dev/null 2>&1; then ok=1; break; fi
  sleep 0.1
done
[ -n "$ok" ] || fail "server never came up"

# --- runnerd: the compute half, when this placement dispatches jobs ----------
# runnerd hands its OWN CAOS_SERVER_URL to every worker it launches
# (crates/runnerd/src/main.rs). Where workers share this netns — the test
# placement, `container:<self>` — loopback is right for both. On the host they
# get their own netns on a bridge, so runnerd must advertise a name that
# resolves there; it also resolves from in here, via the stack's alias.
#
# CAOS_STACK_RUNNER_REDIS_ADDR is the same two-value shape for the same reason,
# and defaults the same way: loopback is right wherever workers share this
# netns, and the host placement overrides it with `caos-redis:<port>`. A worker
# that finds it unset has no cache offered and must still do the work.
#
start_runnerd() { # <log-name> <slots> <require>
  local name=$1 slots=$2 require=$3 pid ok=""
  start "$name" env \
    CAOS_SERVER_URL="${CAOS_STACK_RUNNER_SERVER_URL:-$SERVER_URL}" \
    CAOS_WORKER_REDIS_ADDR="${CAOS_STACK_RUNNER_REDIS_ADDR:-$REDIS_ADDR}" \
    CAOS_DOCKER_BIN="${CAOS_DOCKER_BIN:-docker}" \
    CAOS_RUNNER_SLOTS="$slots" \
    CAOS_RUNNER_REQUIRE="$require" \
    "$CAOS_STACK_BIN/runnerd"
  # WAIT FOR THE LINE, do not sleep for it. This was an unconditional `sleep 1`
  # followed by one grep, so every stack that dispatches jobs paid a full second
  # whether or not runnerd was already up — and it still failed spuriously if
  # runnerd happened to be slower than the sleep.
  pid=${pids[$((${#pids[@]} - 1))]}
  for _ in $(seq 1 300); do
    if grep -q "slots, server" "$CAOS_STACK_LOGS/$name.log" 2>/dev/null; then ok=1; break; fi
    if ! kill -0 "$pid" 2>/dev/null; then
      break
    fi
    sleep 0.05
  done
  [ -n "$ok" ] || fail "$name did not start"
}

if [ "$CAOS_STACK_RUNNERD" = yes ]; then
  start_runnerd runnerd "${CAOS_RUNNER_SLOTS:-8}" ""
fi

# --- caos-iroh: the same server, reachable by ticket -------------------------
# A member like any other, so it shares the group's lifetime and its log, and
# `caosd logs` shows the ticket it published.
#
# It needs BOTH halves of this stack's surface: `--to` for the HTTP API (the
# server is already up, checked above) and `--git-dir` for git, which it serves
# by spawning `git upload-pack`/`receive-pack` on the same repo the server uses.
# That is not a way around the server's protections — they are git config on the
# repo (see design/iroh-transport.md).
#
# NOT WAITED FOR, unlike the members above. Binding an endpoint means reaching a
# relay, so it takes seconds and can fail on a machine with no route out — and
# nothing else here depends on it. Blocking bring-up on it would make every
# local stack pay for a capability it is not using. (It is still a MEMBER, so if
# it ever exits the group goes down and says so: a stack that has stopped
# answering its ticket while claiming to be up is the failure worth being loud
# about, and SPEC's reliability principle asks for exactly that.)
if [ "${CAOS_STACK_IROH:-no}" = yes ]; then
  IROH_STATE=${CAOS_STACK_IROH_STATE:-$CAOS_STACK_STATE/iroh}
  mkdir -p "$IROH_STATE"
  # FATAL HERE, where the message is read, rather than minting a ticket that
  # cannot be reached. n0's relays are never used (caos_iroh::endpoint_builder),
  # so there is nothing to fall back to -- and a ticket carrying an unreachable
  # relay keeps its endpoint id and token, so it is indistinguishable from the
  # one already in someone's environment while every session against it times
  # out a whole phase away from here.
  if [ -z "${CAOS_IROH_RELAY:-}" ]; then
    fail "CAOS_STACK_IROH=yes but no CAOS_IROH_RELAY: a caos:// endpoint needs a
  relay of its own to be reached through. Run 'iroh-relay --dev' on a host you
  control, on port 80 or 443, and bring the stack up with
  CAOS_IROH_RELAY=http://<host>/ caosd up --iroh"
  fi
  # An ARRAY built by word-splitting on purpose: the variable carries zero or
  # more addresses, and each needs its own flag.
  iroh_advertise=()
  for addr in ${CAOS_STACK_IROH_ADVERTISE:-}; do
    iroh_advertise+=(--advertise "$addr")
  done
  # The server this script started, as a host:port — `SERVER_URL` above is the
  # same address in URL form, on the default port.
  start caos-iroh "$CAOS_STACK_BIN/caos-iroh" serve \
    --state "$IROH_STATE" \
    --to "127.0.0.1:80" \
    --git-dir "$CAOS_STACK_STATE/git" \
    --relay "$CAOS_IROH_RELAY" \
    "${iroh_advertise[@]}"
fi

# A SEPARATE endpoint and ticket for the bundled hermes gateway, reached by a
# STOCK `dumbpipe` on both ends (design/iroh-transport.md's token rationale
# doesn't apply here: that token exists because an endpoint id can otherwise
# be the only thing standing between the internet and a caos server that
# runs containers and sees every secret -- this bridge protects nothing of
# the kind, since `hermes serve` below binds LOOPBACK specifically so its
# own auth gate is off entirely (Hermes's dashboard-auth skill: the gate
# engages ONLY on a non-loopback bind). The ticket is already the one and
# only credential either way; a caos-authored token-then-splice protocol on
# top would add nothing a stock binary doesn't already give for free, and
# costs a client-side tool nobody else has to build or install.
# `dumbpipe connect-tcp <ticket>` on the desktop end is the whole client.
#
# INDEPENDENT of CAOS_STACK_IROH/CAOS_IROH_RELAY above, deliberately: those
# exist because `caos_iroh::endpoint_builder` never uses n0's own relays (a
# Claude Code cloud container can't reach them -- see that function's own
# comment), so the MAIN caos-iroh endpoint needs an explicitly named relay of
# this server's own or it fails fast rather than mint an unreachable ticket.
# A stock `dumbpipe`, in contrast, is happy with iroh's ordinary default relay
# infrastructure -- it takes no `--relay` flag at all -- so requiring
# CAOS_STACK_IROH=yes here too would force standing up a relay this specific
# bridge has no actual need for, just to reach your own bundled dashboard.
if [ "${CAOS_STACK_HERMES:-yes}" = yes ]; then
  IROH_HERMES_STATE=${CAOS_STACK_IROH_HERMES_STATE:-$CAOS_STACK_STATE/iroh-hermes}
  mkdir -p "$IROH_HERMES_STATE"
  # A persisted secret key, the same reasoning as hermes-gateway.secret
  # below: dumbpipe mints a random one per process otherwise, which would
  # mint a brand new endpoint id (and so a dead ticket) on every `caosd up`.
  hermes_iroh_secret="$IROH_HERMES_STATE/secret"
  if [ ! -s "$hermes_iroh_secret" ]; then
    (umask 177 && head -c 32 /dev/urandom | od -An -tx1 | tr -d ' \n' >"$hermes_iroh_secret")
  fi
  # A fixed port (not dumbpipe's default random one), so the ticket's own
  # direct addresses stay useful across restarts for a firewall rule or a
  # direct (non-relayed) connection -- same reasoning as caos-iroh's own
  # bind_endpoint. 11205, unclaimed by the main caos-iroh endpoint's 11204
  # (only actually in use when CAOS_STACK_IROH=yes, but kept distinct
  # regardless so the two never collide if both happen to run).
  start caos-iroh-hermes env IROH_SECRET="$(cat "$hermes_iroh_secret")" \
    dumbpipe listen-tcp \
    --host "127.0.0.1:$HERMES_PORT" \
    --ipv4-addr "0.0.0.0:${CAOS_STACK_IROH_HERMES_PORT:-11205}" \
    --ipv6-addr "[::]:${CAOS_STACK_IROH_HERMES_PORT:-11205}"

  # A `ticket` FILE in $IROH_HERMES_STATE, mirroring the main caos-iroh
  # endpoint's own $IROH_STATE/ticket -- not just a log line. Unlike
  # `caos-iroh`, plain `dumbpipe` has no --ticket-file/equivalent of its own
  # (checked its --help directly): it only ever prints the ticket on
  # stderr, as part of a human-readable "dumbpipe connect-tcp <ticket>"
  # line, which is all caos-iroh-hermes.log has ever held. Pull the ticket
  # back out of that same log and persist it as its own file, so
  # `cat $IROH_HERMES_STATE/ticket` works the same way it already does for
  # the main endpoint, instead of grep-ing a log by hand.
  #
  # SYNCHRONOUS, not backgrounded: a bare `wait -n` (the supervisor below)
  # waits on ANY background job of this shell, not just the ones tracked in
  # $pids -- confirmed the hard way, a backgrounded version of this exact
  # poll loop finished after ~10s and the supervisor treated that completely
  # unrelated exit as "a member died", tearing down the whole stack a few
  # seconds after every `caosd up`. Blocking here instead costs at most 10s
  # of startup, once, and guarantees the ticket file exists before this
  # script ever reports "stack up".
  hermes_ticket_log="$CAOS_STACK_LOGS/caos-iroh-hermes.log"
  for _ in $(seq 1 50); do
    hermes_ticket=$(grep -o 'dumbpipe connect-tcp [a-z0-9]*' "$hermes_ticket_log" 2>/dev/null \
      | awk '{print $NF}') || true
    if [ -n "$hermes_ticket" ]; then
      printf '%s\n' "$hermes_ticket" >"$IROH_HERMES_STATE/ticket"
      break
    fi
    sleep 0.2
  done

  # Stale leftovers from an EARLIER, no-longer-used approach for this same
  # bridge (a caos-iroh-based one, before settling on stock dumbpipe) --
  # `key`/`token` are caos-iroh's own state-file names, meaningless to
  # dumbpipe, and a stale `ticket` here (caos-iroh's own `caos://...` URI
  # form, not a dumbpipe ticket at all) would be actively misleading
  # sitting next to the real one this now writes. Removed once, every
  # boot, before the real ticket file above gets written.
  rm -f "$IROH_HERMES_STATE/key" "$IROH_HERMES_STATE/token"
fi

# --- core-seeder-runner: the bootstrap answerer, when this placement wants it -
# --- publish std, and seed the core from what it just published --------------
# THE ONE PUBLISH IN THE TREE, for the same reason this is the one bring-up.
# It used to be two — `caosd std_build` on the host and `dev/stack-up` inside
# the dev worker — each with its own copy of build-builtins' environment, and
# each responsible for getting the resulting records to a seeder it did not
# start. Here the two steps are adjacent, so the seed tree is a VALUE handed
# from one line to the next.
#
# ORDER. build-builtins needs the server (it pushes objects and asks
# `HEAD /object/…`) and the registry (skopeo, and a `curl -I` for each manifest
# digest) — both already up above. It needs NO runner and NO seeder: it
# hand-assembles every `required` from deltas it built itself rather than by
# running the evaluator, which is exactly what makes this order possible.
#
# STDOUT IS THE TREE. Everything build-builtins narrates goes to stderr, so the
# capture below is the seed tree and nothing else.
if [ "${CAOS_STACK_PUBLISH:-no}" = yes ]; then
  publish="${CAOS_STACK_PUBLISH_SCRIPT:?serve needs CAOS_STACK_PUBLISH_SCRIPT when CAOS_STACK_PUBLISH=yes}"
  [ -f "$publish" ] || fail "no publish script at $publish"
  echo "caosd serve: publishing std ($publish)" >&2
  CAOS_SEED_TREE=$(CAOS_SERVER_URL="$SERVER_URL" bash "$publish" 2>>"$CAOS_STACK_LOGS/publish.log") \
    || { cat "$CAOS_STACK_LOGS/publish.log" >&2; fail "publishing std"; }
  [ -n "$CAOS_SEED_TREE" ] || fail "the publish produced no seed tree (see $CAOS_STACK_LOGS/publish.log)"
  echo "caosd serve: published, seed tree $CAOS_SEED_TREE" >&2
fi

# The bootstrap answerer (design/caos-expr.md, Phase 3): it reads the seed
# records out of the tree we were just handed and long-polls the server,
# answering each seeded arg-tree key with a pre-built result and spawning no
# container. Optional and default OFF — the seed placement only PUBLISHES.
#
# Started AFTER the publish, with its records passed by value. There is no ref
# and nothing to poll for: the process that produced the records starts the
# process that serves them, so they cannot be replaced underneath it and there
# is no window where the core is unanswered.
if [ "${CAOS_STACK_SEEDER:-no}" = yes ]; then
  : "${CAOS_SEED_TREE:?serve needs a seed tree for the seeder — set CAOS_STACK_PUBLISH=yes, or pass CAOS_SEED_TREE}"
  start core-seeder-runner env \
    CAOS_SERVER_URL="$SERVER_URL" \
    CAOS_GIT_DIR="$CAOS_STACK_STATE/git" \
    CAOS_SEED_TREE="$CAOS_SEED_TREE" \
    "$CAOS_STACK_BIN/core-seeder-runner"
fi

# --- the bundled Hermes gateway: CAOS_STACK_HERMES=yes, the default --------
# ONE PER STACK, co-located with its own server -- CAOS_MCP_DEFAULT_SERVER
# below is $SERVER_URL itself, so a session this gateway starts never needs a
# ticket or address copied in by hand. Malcolm's Desktop connects via
# Settings -> Gateways -> Remote gateway, signs in, and picks "caos" from the
# profile switcher: `hermes serve` is inherently multi-profile (one server,
# every profile on the machine), so which profile a SESSION gets is the
# client's choice, never a server-startup flag.
#
# NOT `hermes --profile caos serve`. Measured directly: `--profile <name>`
# (with or without --isolated) refuses EVERY non-loopback bind with "no auth
# providers are registered", regardless of what dashboard.basic_auth holds --
# a reproducible bug in this build (confirmed with an otherwise-identical
# config that works the moment the flag is dropped). Bare `hermes serve`
# reads the SAME machine-level config.yaml for its own auth gate and hits
# none of this; dropping --profile costs nothing a session needs, since the
# profile is a connecting client's choice regardless.
#
# BOUND 127.0.0.1, ON PURPOSE: this is what turns Hermes's own dashboard-auth
# gate off entirely (Hermes's dashboard-auth skill: the gate engages ONLY on a
# non-loopback bind, no override flag exists that skips it while keeping a
# non-loopback bind). Real access control for this gateway is the iroh bridge
# below (a stock `dumbpipe listen-tcp` pointed at this same port) rather than
# Hermes's own login -- the login never provided per-user identity or
# isolation anyway (every authenticated user shares one profile and its full
# session history regardless of which provider they logged in through), so a
# second, weaker gate in front of it bought nothing. The direct
# docker-published port (`-p 127.0.0.1:$PORT:$PORT` on the host side) now
# reaches nothing: docker's forward lands on the container's EXTERNAL
# interface, which a loopback-bound process cannot see (same fact as the
# reverse case this comment used to describe) -- the iroh bridge is the only
# way in from outside this container now.
if [ "${CAOS_STACK_HERMES:-yes}" = yes ]; then
  : "${CAOS_STACK_HERMES_PROFILE:?serve needs CAOS_STACK_HERMES_PROFILE when CAOS_STACK_HERMES=yes}"
  hermes_bin=${CAOS_STACK_HERMES_BIN:-hermes}
  hermes_home="$CAOS_STACK_STATE/hermes"
  mkdir -p "$hermes_home"

  # NOW INERT, given the loopback bind above -- kept rather than deleted, in
  # case CAOS_STACK_HERMES_PORT/the bind ever needs to go back to 0.0.0.0 for
  # local debugging (e.g. reaching the dashboard directly without an iroh
  # client installed). FIXED USERNAME/PASSWORD AS A FALLBACK, `nous` OAuth
  # against Nous Portal (Google/Microsoft/GitHub/email upstream, no
  # per-provider dev keys on this gateway's side) as the real per-user path,
  # `self_hosted` OIDC reserved for a future real IdP -- none of them matter
  # while nothing but 127.0.0.1 can reach this port.
  #
  # The gateway's own login credential, generated ONCE and kept OUTSIDE the
  # profile dir: the install above is `--force`d on every boot (so a tree
  # edit always lands), which overwrites config.yaml, and regenerating this
  # on every restart would log every existing Desktop session out for no
  # reason. base64 of urandom, not openssl -- this image carries coreutils,
  # not openssl.
  hermes_secret="$CAOS_STACK_STATE/hermes-gateway.secret"
  if [ ! -s "$hermes_secret" ]; then
    (umask 177 && head -c 24 /dev/urandom | base64 >"$hermes_secret")
  fi
  hermes_password=$(cat "$hermes_secret")

  # The SESSION-TOKEN-SIGNING secret, persisted the same way and for the
  # same reason -- NOT the login password above, a separate key entirely.
  # Confirmed directly in plugins/dashboard_auth/basic's own source: left
  # unset, it generates "a random per-process secret" every single boot,
  # which signs every session cookie already issued invalid the moment
  # this restarts -- Desktop (or a browser) then has no option but a fresh
  # login, even typing the SAME correct password right back in. This was
  # the actual cause of "hermes keeps losing the login" on every rebuild.
  hermes_session_secret="$CAOS_STACK_STATE/hermes-gateway-session.secret"
  if [ ! -s "$hermes_session_secret" ]; then
    (umask 177 && head -c 32 /dev/urandom | base64 >"$hermes_session_secret")
  fi

  # The DASHBOARD SESSION TOKEN -- a THIRD, independent secret from the two
  # above, and the one that actually matters for this bridge: it gates
  # sensitive /api routes regardless of dashboard-auth login state, and on a
  # LOOPBACK bind (ours, now) it is the ONLY credential Hermes Desktop's own
  # "Remote gateway" connection form will accept -- the form always demands
  # either a session token or OAuth to save a connection at all, even when
  # the backend needs neither (a known Desktop UI gap, not specific to this
  # gateway). Left unset, `hermes serve` mints a fresh random one every
  # single boot with nothing printed anywhere to copy it from, so pin and
  # persist it the same way as the two secrets above. Passed as an env var
  # on the `hermes serve` invocation ONLY, never written into .env: Hermes
  # loads `~/.hermes/.env` with override=True, which would force this same
  # value onto every OTHER hermes process on the machine, not just this one.
  #
  # Fixed to the literal "caos", not a random value -- it's checked by exact
  # string match on sensitive /api routes with NO loopback/peer-IP carve-out
  # of any kind (confirmed directly: even a genuinely loopback request with
  # no token, or an empty one, gets the identical {"detail":"Unauthorized"}
  # as a wrong one), so it IS a real credential, but not the one actually
  # gatekeeping this bridge -- the iroh ticket is (nothing reaches this port
  # at all without one). A short, memorable value is a deliberate
  # usability trade against a secret that's genuinely redundant on top of
  # the ticket, same reasoning as dropping the custom relay token earlier.
  # Still a FILE, not a bare literal, so an operator who wants a real random
  # secret can still write one in by hand -- only the DEFAULT changed.
  hermes_ws_token="$CAOS_STACK_STATE/hermes-gateway-ws.secret"
  if [ ! -s "$hermes_ws_token" ]; then
    (umask 177 && printf '%s' caos >"$hermes_ws_token")
  fi

  # Locating the interpreter hash_password() needs: the `hermes` wrapper nix
  # builds bakes it in as `export HERMES_PYTHON='...'` for exactly this (no
  # public subcommand does it). Pure text extraction, not sourcing -- the
  # wrapper's last line execs hermes itself, so sourcing it would replace
  # this shell rather than return.
  hermes_python=$(grep -o "export HERMES_PYTHON='[^']*'" "$(command -v "$hermes_bin")" 2>/dev/null \
    | sed "s/^export HERMES_PYTHON='//; s/'\$//")
  [ -n "$hermes_python" ] || fail "could not find HERMES_PYTHON in $hermes_bin's own wrapper"
  hermes_hash=$("$hermes_python" -c \
    "from plugins.dashboard_auth.basic import hash_password; print(hash_password('$hermes_password'))")

  # MACHINE-LEVEL config (dashboard.basic_auth + enabling the `basic`
  # provider plugin) -- NOT a profile's own config.yaml, and genuinely
  # root-only: `hermes serve` unifies every profile behind ONE server and
  # reads its OWN login gate from the root, never from --profile (see
  # above) -- there is no per-profile equivalent to set.
  HERMES_HOME="$hermes_home" "$hermes_bin" config set dashboard.basic_auth.username caos \
    >"$CAOS_STACK_LOGS/hermes-install.log" 2>&1
  HERMES_HOME="$hermes_home" "$hermes_bin" config set dashboard.basic_auth.password_hash "$hermes_hash" \
    >>"$CAOS_STACK_LOGS/hermes-install.log" 2>&1
  # "nous" (the bundled dashboard_auth/nous plugin) rides along unconditionally:
  # it self-gates on whether dashboard.oauth.client_id/HERMES_DASHBOARD_OAUTH_
  # CLIENT_ID is actually configured, so listing it here is a no-op until
  # someone runs `hermes auth add nous --type oauth` + `hermes dashboard
  # register` once (by hand, interactively -- it's a real OAuth login against
  # the operator's own Nous account) inside this HERMES_HOME. That registration
  # writes HERMES_DASHBOARD_OAUTH_CLIENT_ID into $hermes_home/.env itself,
  # which write_caos_env_file's preserve-filter leaves untouched, so it
  # survives every future `caosd up` with no extra wiring here.
  #
  # UNCONDITIONAL, every boot, regardless of profile_is_hardened below: this
  # bit it once (fixed the hard way -- `default` lost `caos-hooks` from this
  # SAME list on a second `caosd up`, failing every caos tool call with
  # "caos_session is missing: the PreToolUse hook... is not installed").
  # `profile_is_hardened` exists to skip the EXPENSIVE, rarely-changing part
  # below (mcp_servers, discovery timeouts) on an already-hardened restart --
  # it must never also gate a cheap write whose content is build-specific
  # (the plugin list above, the env file below), or a later restart silently
  # reverts caos-hooks out of it, or keeps the env file pointing at a build
  # that's already been garbage-collected, while everything else moves on.
  caos_root_plugins='["basic","nous"]'
  if [ "${CAOS_STACK_HERMES_DEFAULT_TOOLS:-yes}" = yes ]; then
    caos_root_plugins='["basic","nous","caos-hooks"]'
  fi
  HERMES_HOME="$hermes_home" "$hermes_bin" config set plugins.enabled "$caos_root_plugins" \
    >>"$CAOS_STACK_LOGS/hermes-install.log" 2>&1

  # Cheap, no-`hermes`-subprocess check: has root's own config.yaml already
  # been hardened? Lets this stay idempotent/cheap to re-run across restarts
  # without spawning `hermes config set` subprocesses for keys that already
  # hold the right value. Deliberately does NOT cover plugins.enabled -- see
  # above -- and must NOT cover write_caos_env_file either, for the same
  # reason: this check only asks whether config.yaml HAS the right KEYS
  # (disabled_toolsets:, mcp_servers:), never whether the env file's VALUES
  # are still current. Those values are nix store paths
  # (CAOS_HERMES_DIST_DIR, CAOS_BIN) that are different on every build, so
  # config.yaml's shape staying constant across restarts says nothing about
  # whether the paths pinned in .env still exist. Confirmed the hard way:
  # two full `deploy-caosd-prod` rebuilds in a row, each producing a new
  # caos-stack-inputs store path, left .env (and therefore the MCP server
  # Hermes actually launches) pointing at the FIRST boot's path from days
  # earlier, forever -- config.yaml already had `mcp_servers:` from that
  # first boot, so this check kept saying "hardened" and skipping the
  # rewrite on every subsequent restart.
  profile_is_hardened() { # <config.yaml path>
    local cfg=$1
    [ -f "$cfg" ] || return 1
    grep -q '^  disabled_toolsets:' "$cfg" || return 1
    if [ "${CAOS_STACK_HERMES_DEFAULT_TOOLS:-yes}" = yes ]; then
      grep -q '^mcp_servers:' "$cfg" || return 1
      # Config can say caos-hooks is enabled while the plugin's own code
      # was never copied (confirmed the hard way -- see the cp -RL below).
      # Check the actual file, not just config.yaml's say-so.
      [ -f "$(dirname "$cfg")/plugins/caos-hooks/__init__.py" ] || return 1
    fi
    return 0
  }

  # Apply caos's hardening -- the SAME toolset ban caos's own distribution
  # applies to itself (agent.disabled_toolsets: terminal/file/code_execution)
  # -- and, by default, caos's own MCP tools too -- to the ROOT `default`
  # profile ONLY, for now.
  #
  # WHY THIS EXISTS AT ALL, not just on a separately named `caos` profile:
  # `hermes serve` is multi-profile and profile choice is the CONNECTING
  # CLIENT's -- nothing server-side forces anyone onto any specific profile
  # (Hermes refuses to let a distribution install itself AS `default`, "that
  # name is the built-in root profile"), so a client that never bothers
  # picking a profile lands on bare `default` instead. Confirmed directly:
  # `default` already had a real model configured (Nous Portal, plus a live
  # ANTHROPIC_API_KEY credential) and none of caos's own restrictions --
  # stock `terminal`/`file`/`code_execution` fully enabled, genuine shell
  # access to this container (it runs runnerd and can reach the docker
  # socket). This closes exactly that gap, unconditionally, every boot.
  #
  # DELIBERATELY NOT GENERALIZED to every OTHER profile someone might create
  # (a `hermes profile create <name>`, or Desktop's own `+` -- confirmed a
  # real, remotely-reachable path: it POSTs to /api/profiles on the
  # connected backend and the new profile is live immediately, no admin
  # step). That needs a real answer to "does this gateway's single `hermes
  # serve` process apply plugins/mcp_servers per-profile or once for
  # everything it multiplexes" before building anything -- a write-once
  # (or even a poll) is racy against a profile created mid-session, and the
  # right fix depends on that still-unverified answer. Tracked as separate,
  # deliberately deferred work -- this `default` profile is the only one
  # this gateway has today (the `caos` and `malcolm` named profiles were
  # both removed), so it is not an active gap on THIS stack.
  apply_caos_profile_hardening() {
    local cfg="$hermes_home/config.yaml" env_file="$hermes_home/.env"
    # Unconditional, every boot, same reasoning as caos_root_plugins above:
    # CAOS_HERMES_DIST_DIR/CAOS_BIN are THIS build's nix store paths, not a
    # one-time fact about the profile, so this can never sit behind
    # profile_is_hardened -- see that function's own comment. Also
    # unconditional on CAOS_STACK_HERMES_DEFAULT_TOOLS: the write itself is
    # inert when that's "no" (nothing reads these vars back out of .env
    # unless mcp_servers.caos is ALSO configured, which stays gated on it
    # below), so there is nothing to protect by skipping it.
    write_caos_env_file "$env_file"

    profile_is_hardened "$cfg" && return 0

    HERMES_HOME="$hermes_home" "$hermes_bin" config set agent.disabled_toolsets \
      '["terminal","file","code_execution"]' \
      >>"$CAOS_STACK_LOGS/hermes-install.log" 2>&1

    if [ "${CAOS_STACK_HERMES_DEFAULT_TOOLS:-yes}" = yes ]; then
      # The actual PLUGIN CODE, not just config referencing it by name --
      # `hermes profile install` used to copy this as part of installing
      # the whole distribution into a NAMED profile; now that this writes
      # config.yaml keys directly instead, nothing else ever puts the
      # plugin's own files where PluginManager looks for them
      # ($HOME/plugins/<name>/). Confirmed the hard way: plugins.enabled
      # correctly listed "caos-hooks" and EVERY caos tool call still failed
      # with "caos_session is missing: the PreToolUse hook... is not
      # installed" -- the config said the plugin was on, but the plugin's
      # own __init__.py/plugin.yaml were never on disk to load at all.
      # cp -RL, not -R: contents inside a nix build product are symlinks
      # into /nix/store (dockerTools' lndir mirrors dirs, symlinks files),
      # and -L follows them to real content.
      mkdir -p "$hermes_home/plugins"
      rm -rf "$hermes_home/plugins/caos-hooks"
      cp -RL "$CAOS_STACK_HERMES_PROFILE/plugins/caos-hooks" "$hermes_home/plugins/caos-hooks"
      HERMES_HOME="$hermes_home" "$hermes_bin" config set \
        plugins.entries.caos-hooks.granted_capabilities '["tools.override"]' \
        >>"$CAOS_STACK_LOGS/hermes-install.log" 2>&1
      HERMES_HOME="$hermes_home" "$hermes_bin" config set mcp_discovery_timeout 180 \
        >>"$CAOS_STACK_LOGS/hermes-install.log" 2>&1
      HERMES_HOME="$hermes_home" "$hermes_bin" config set \
        mcp_single_query_discovery_timeout 180 \
        >>"$CAOS_STACK_LOGS/hermes-install.log" 2>&1
      # One JSON object for the whole mcp_servers key (matches
      # integrations/hermes/config.yaml's own mcp_servers.caos entry exactly;
      # the ${VAR} forms are written LITERALLY -- hermes's own config loader
      # resolves them from this profile's own .env at MCP-launch time, the
      # same mechanism the caos distribution's own config.yaml already
      # relies on, not something this script evaluates itself).
      # --force: without it, a SECOND run of this exact call (mcp_servers
      # already existing as a recognized section from the first) is
      # refused outright -- "'mcp_servers' is a configuration section...
      # Use --force to replace the entire section" -- confirmed the hard
      # way, this killed a whole `caosd up` on the very next restart.
      HERMES_HOME="$hermes_home" "$hermes_bin" config set --force mcp_servers \
        '{"caos":{"command":"${CAOS_HERMES_DIST_DIR}/scripts/caos-mcp-launch","args":[],"env":{"CAOS_HERMES_DIST_DIR":"${CAOS_HERMES_DIST_DIR}","CAOS_REPO":"${CAOS_REPO}","CAOS_BIN":"${CAOS_BIN}","CAOS_LLM_STEP_REV":"${CAOS_LLM_STEP_REV}","CAOS_MCP_DEFAULT_SERVER":"${CAOS_MCP_DEFAULT_SERVER}","SSL_CERT_FILE":"${SSL_CERT_FILE}","NIX_SSL_CERT_FILE":"${NIX_SSL_CERT_FILE}"},"timeout":1800,"connect_timeout":300}}' \
        >>"$CAOS_STACK_LOGS/hermes-install.log" 2>&1
    fi
  }
  apply_caos_profile_hardening

  echo "caosd serve: hermes gateway bound to loopback -- its own login is off; reach it over the iroh bridge (ticket in \$CAOS_DATA/stack/iroh-hermes/ticket, 'dumbpipe connect-tcp --addr 127.0.0.1:$HERMES_PORT <ticket>' on the desktop); Desktop's Remote-gateway connection form still wants a Session token -- it's 'caos' (\$CAOS_DATA/stack/hermes-gateway-ws.secret) unless overridden" >&2
  start hermes env HERMES_HOME="$hermes_home" \
    HERMES_DASHBOARD_BASIC_AUTH_SECRET="$(cat "$hermes_session_secret")" \
    HERMES_DASHBOARD_SESSION_TOKEN="$(cat "$hermes_ws_token")" \
    "$hermes_bin" serve --host 127.0.0.1 --port "$HERMES_PORT" --skip-build
fi

# Not `[ ... ] && ...`: under `set -e` a false test would make that list the
# script's last status and exit 0 right here, silently skipping the supervisor.
if [ -n "${CAOS_STACK_READY:-}" ]; then
  : > "$CAOS_STACK_READY"
fi
echo "caosd serve: ${names[*]} up on $SERVER_URL" >&2

# --- supervise ---------------------------------------------------------------
# `wait -n` returns when the FIRST member exits — which, since none of them is
# supposed to exit, always means something is wrong. Name it, take the rest
# down, and fail.
wait -n
for i in "${!pids[@]}"; do
  kill -0 "${pids[$i]}" 2>/dev/null || dead=${names[$i]}
done
kill "${pids[@]}" 2>/dev/null || true
wait 2>/dev/null || true
fail "${dead:-a member} exited — the stack is down (see $CAOS_STACK_LOGS)"
