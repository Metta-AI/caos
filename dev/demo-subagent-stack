#!/usr/bin/env bash
# With OWNER/NEW-REPO, create a private GitHub repo and push the demo baseline.
# Without an argument, prepare the local files only.
set -euo pipefail
if [ "$#" -gt 1 ]; then
  echo "usage: $0 [OWNER/NEW-REPO]" >&2
  exit 2
fi
repo=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
cli=${CAOS_DEMO_CLI:-$repo/result/bin/caos}
destination=${1:-}
if [ ! -x "$cli" ]; then
  echo "Build result/bin/caos first, or set CAOS_DEMO_CLI to its absolute path." >&2
  exit 1
fi
case "$cli" in
  /*) ;;
  *) echo "CAOS_DEMO_CLI must be an absolute path." >&2; exit 1 ;;
esac
if [ -n "$destination" ]; then
  if [[ ! "$destination" =~ ^[A-Za-z0-9-]+/[A-Za-z0-9._-]+$ ]]; then
    echo "Expected OWNER/NEW-REPO for a new, private GitHub repository." >&2
    exit 2
  fi
  gh auth status >/dev/null
fi

mkdir -p "$repo/.caos-dev"
demo=$(mktemp -d "$repo/.caos-dev/subagent-demo.XXXXXX")
mkdir "$demo/repo"
for file in greet.sh README.md AGENTS.md; do
  cp "$repo/examples/subagent-stack/$file" "$demo/repo/$file"
done
cp "$repo/examples/subagent-stack/PROMPT.md" "$demo/PROMPT.md"
chmod +x "$demo/repo/greet.sh"
git init -q -b main "$demo/repo"
git -C "$demo/repo" config user.name "Workspace Demo"
git -C "$demo/repo" config user.email "workspace-demo@example.invalid"
git -C "$demo/repo" add .
git -C "$demo/repo" commit -qm "Start greeting demo"

if [ -n "$destination" ]; then
  gh repo create "$destination" --private --source "$demo/repo" --remote origin --push
fi

{
  printf '#!/usr/bin/env bash\nset -euo pipefail\n'
  printf 'cd %q\n' "$demo/repo"
  printf 'exec %q tui --new "$@"\n' "$cli"
} > "$demo/launch"
chmod +x "$demo/launch"
printf 'Demo directory: %s\nPrompt: %s/PROMPT.md\nLaunch: %s/launch\n' "$demo" "$demo" "$demo"
if [ -z "$destination" ]; then
  printf '\nLocal setup only. Before launching, create a new GitHub repository:\n'
  printf 'gh repo create OWNER/NEW-REPO --private --source %q --remote origin --push\n' "$demo/repo"
fi
printf '\nIn the TUI, paste PROMPT.md and submit with Ctrl+S.\n'
printf 'After the agent finishes, Ctrl+O inspects workspaces; Ctrl+P previews the PR stack.\n'
