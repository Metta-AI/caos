#!/usr/bin/env bash
# dev/resident-test — std/bash's script interpreter, on an image that declares
# itself resident (flake.nix). Fetch `worker1` and run it with bash; a resident
# `worker1` loops on `caos next`, so this does not return until the daemon
# leaves.
#
# On exit caos reads the hash of /cas/out; a script that left none stores an
# empty blob so there is something to read. A daemon that `caos next` told to
# leave exits through here too, after its last result was already posted, and
# the runner has killed it by then.
set -euo pipefail

caos get /cas/args/worker1
bash /cas/args/worker1
if [ ! -e /cas/out ]; then
  : > /tmp/caos-empty-out
  caos put /tmp/caos-empty-out /cas/out
fi
