{
  "permissions": {
    "deny": [
      "Read",
      "Write",
      "Edit",
      "NotebookEdit",
      "Glob",
      "Grep"
    ],
    "allow": [
      "mcp__caos"
    ]
  },
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          { "type": "command", "command": "\"${CAOS_BIN:-caos}\" cc hook --llm-step:@=std/llm-step" }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "mcp__caos__.*",
        "hooks": [
          { "type": "command", "command": "\"${CAOS_BIN:-caos}\" cc hook --llm-step:@=std/llm-step" }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "\"${CAOS_BIN:-caos}\" cc hook --llm-step:@=std/llm-step" }
        ]
      }
    ],
    "StopFailure": [
      {
        "hooks": [
          { "type": "command", "command": "\"${CAOS_BIN:-caos}\" cc hook --llm-step:@=std/llm-step" }
        ]
      }
    ]
  }
}
