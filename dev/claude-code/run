#!/usr/bin/env bash
# Launch Claude Code against a caos workspace (see rust/crates/caos-cli/CC.md).
#
# Everything this sets up could be passed by hand -- `claude --settings
# dev/claude-code/settings.json --mcp-config dev/claude-code/mcp.json
# --strict-mcp-config` -- except one thing, which is why this script exists.
#
# `${CLAUDE_PROJECT_DIR}` expands in a HOOK command but NOT in mcp.json.
# Claude Code sets that variable in the environment of a spawned stdio server;
# it is not in Claude Code's OWN environment, which is what mcp.json expansion
# reads. An unset variable there is not an error either: Claude Code warns, uses
# the literal `${CLAUDE_PROJECT_DIR}` as the command, and still "loads" the
# server -- so the failure surfaces only as a model that quietly has no caos
# tools and cheerfully pretends it used them. So mcp.json reads `${CAOS_BIN}`
# and this script exports it.
set -euo pipefail

here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
repo="$(cd "$here/../.." && pwd)"

CAOS_BIN="${CAOS_BIN:-$repo/result/bin/caos}"
if [ ! -x "$CAOS_BIN" ]; then
    echo "no caos binary at $CAOS_BIN -- run \`nix build\` first," >&2
    echo "or set CAOS_BIN to one (e.g. rust/target/debug/caos-cli)." >&2
    exit 1
fi
export CAOS_BIN

# Prove the server actually answers before handing it to a session, so a broken
# binary or an unreachable server is an error here rather than a toolless model
# later. `tools/list` is a WORKER RUN -- the tools are `std/llm-step`'s and it
# is asked to describe them -- so this probe needs the caos server up, and the
# same `--llm-step` mcp.json passes.
#
# Stderr is kept: a listing that fails says why there, and "no tools" without
# the reason is the failure this whole script exists to prevent.
#
# The output is captured rather than piped into `grep -q`: grep exits at its
# first match and closes the pipe, the server takes SIGPIPE, and under
# `pipefail` that pipeline reports failure for a probe that in fact SUCCEEDED.
probe="$(printf '%s\n' '{"jsonrpc":"2.0","id":1,"method":"tools/list"}' \
    | "$CAOS_BIN" cc serve --llm-step:@=std/llm-step || true)"
case "$probe" in
    *caos_session*) ;;
    *)
        echo "$CAOS_BIN cc serve listed no tools (see the error above)." >&2
        echo "The tools come from std/llm-step through the caos server, so" >&2
        echo "check that the server is up and the binary is current." >&2
        exit 1
        ;;
esac

exec claude \
    --settings "$here/settings.json" \
    --mcp-config "$here/mcp.json" \
    --strict-mcp-config \
    "$@"
