         .secret_key(secret_key)
+        // The OS trust store, not the copy of Mozilla's roots compiled into
+        // iroh by default. Where egress goes through a TLS-intercepting
+        // proxy the relay presents that proxy's certificate, which chains to
+        // a CA only the system knows about -- so a default build reaches no
+        // relay at all while curl and git on the same host are fine.
+        //
+        // This changes the RELAY HOP ONLY. Payloads stay end-to-end
+        // encrypted between endpoint keys; the relay could not read them
+        // before and cannot now.
+        .ca_tls_config(iroh_relay::tls::CaTlsConfig::system())
+        // And use the proxy when the environment names one, instead of
