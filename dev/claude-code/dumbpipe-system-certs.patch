-iroh = { version = "1.0.0", default-features = false, features = ["tls-ring"] }
+iroh = { version = "1.0.0", default-features = false, features = ["tls-ring", "platform-verifier"] }
+iroh-relay = { version = "1.0.0", default-features = false, features = ["platform-verifier"] }
 iroh-tickets = "1.0.0"
 noq = "1.0.0"
 tokio = { version = "1.34.0", features = ["full"] }
