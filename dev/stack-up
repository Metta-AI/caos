#!/usr/bin/env bash
# dev/stack-up — bring a dev stack up inside this worker, and publish std into
# it. Run from a materialized workspace, in the std/dev image.
#
# THE `dev` PLACEMENT. stack/serve's header names the others — `test`, `host`,
# `seed` — and says the container is the caller's decision, not the script's.
# This one is shaped like `test`: the server, runnerd and seeder are children of
# this container and die with it. Nothing is launched as a sibling, so nothing
# collides with the host stack's container, aliases or ports.
#
# SEVERAL OF THESE RUN AT ONCE, each from a different tree, against one host
# stack. That is the case every "what it shares" line below is written for, and
# the rule that makes it work is: SHARE WHAT IS KEYED BY CONTENT, and give
# everything else a name of this container's own.
#
# WHAT IT SHARES, and why each is safe:
#
#   /nix          a granted volume. Content-addressed, and nix locks per
#                 derivation, so concurrent dev stacks build against one store.
#                 The one non-atomic step is dev/test-stack/worker's seeding of
#                 it, which takes a lock in the volume for exactly that reason.
#   /caos-dev/git a granted volume, and the server repo of EVERY dev stack on
#                 this host. Objects are content-addressed, git is built for
#                 concurrent writers (write-temp-rename, ref updates take
#                 lockfiles), GC is off, and EVERY ref anyone writes here is
#                 keyed by content (refs/caos/req/<hash>, including the seed
#                 tree's own push; refs/caos/res/<argTree>) or uniquified per
#                 run by the test that writes it (tests/README.md). There used
#                 to be one exception — `refs/caos/seed`, keyed by NAME — and
#                 removing it is why the seed tree is now passed to the seeder
#                 by value instead (stack/serve, build-builtins.sh).
#   /caos-images  a granted volume, this stack's podman store. Images are
#                 digest-refs and containers/storage locks across processes, so
#                 concurrent engines share it rather than each re-pulling std.
#   redis         the HOST's, shared. Not a volume: two redis servers cannot
#                 share a directory (both start, neither locks, and they
#                 interleave one AOF between two disagreeing datasets), so
#                 stacks that want one cache share the PROCESS. Keyed apart by
#                 CAOS_CACHE_NAMESPACE, below.
#   registry      the host's, by the name that resolves on caos-net. Content
#                 addressed; design/test-stack-image.md argues sharing it
#                 "cannot leak behavior — only work".
#
# WHAT IT DOES NOT SHARE, all of it under $run — and every line was a way two
# concurrent stacks broke each other, not a precaution:
#
#   bin           the symlink naming this stack's client. std/caos-test reads it
#                 to drive the stack it just built, so a second stack repointing
#                 it hands the first the OTHER BUILD's caos-cli, silently.
#   stack.ready   `rm -f`'d before serve starts. A second stack removing the
#                 first's while the first was still watching for it made that
#                 first stack wait out its 60s and die "never came up".
#   logs/         two stacks' server, runnerd and seeder logs interleaved into
#                 one file, which is also the file a failed bring-up dumps.
#   publish-client-repo
#                 the WORST of them. build-builtins stages this build's seed
#                 binaries into it by fixed name (`seed-deep-deps`,
#                 `seed-rustc`) and `git add`s them, so two publishers in one
#                 repo race over both the index lock and the staged bytes — a
#                 seed record naming the other build's binary is the quiet
#                 outcome. It is per-run and removed once std is published.
set -euo pipefail

fail() { echo "stack-up: $*" >&2; exit 1; }

# PHASE MARKERS, same shape as caos-tools/test's: this script is 16 seconds of a
# 37-second single-test run and the split was invisible.
S0=$SECONDS
phase() { echo "==> [stack-up +$((SECONDS - S0))s] $*" >&2; }

inputs=""
for a in "$@"; do
  case "$a" in
    --inputs=*) inputs=${a#--inputs=} ;;
    *) fail "unrecognised argument: $a" ;;
  esac
done
[ -n "$inputs" ] || fail "stack-up needs --inputs=<dir>; the caller builds, this does not"

state=/caos-dev
[ -d "$state" ] || fail "no $state — this image must declare it in CAOS_GRANT_VOLUMES"
[ -f flake.nix ] || fail "no flake.nix in $PWD; run me from a materialized workspace"

# ---- this stack's own corner of the shared volume ---------------------------
# THE CONTAINER IS THE SCOPE, and its id is the name. Everything mutable and
# name-keyed lives under $run; only the object database above is shared.
#
# The container id rather than the build's namespace, because the namespace is
# DELIBERATELY COARSER than the tree: it is the nix out path of
# `caos-test-stack-inputs`, which covers the daemons and the worker images and
# nothing under `std/`. Two trees that differ only in std share a namespace —
# correctly, since the ArgTree tells their work apart — and would then share
# every file below, which nothing tells apart.
#
# ON THE VOLUME rather than in the container's own filesystem, so a failed run
# leaves its logs behind: runnerd deletes the container as soon as the job
# settles, and `$state/runs/<id>/logs/server.log` is the first thing anyone
# reads afterwards. /caos-run is a fixed name for it inside this container, for
# the caller (std/caos-test) that has to find the client without inheriting an
# environment.
instance=$(cat /etc/hostname 2>/dev/null || true)
instance=${instance:-pid-$$}
run=$state/runs/$instance
mkdir -p "$run/logs"
ln -sfn "$run" /caos-run

# Old runs, swept here because this is the one place that knows they are runs.
# By age and only by age: a directory's mtime is set when its entries are
# created, so a live stack's is its start time — hence a bound far longer than
# any job, not a "is it still running" probe there is no way to make from here.
find "$state/runs" -mindepth 1 -maxdepth 1 -type d -mtime +2 \
  -exec rm -rf {} + 2>/dev/null || true

# THE WORKSPACE BECOMES A GIT REPO, because `caos-cli` refuses to run outside a
# working tree (crates/caos/src/lib.rs) and a stack exists to be driven by one.
# Committed at a FIXED date so the commit is a pure function of the tree: a
# commit carrying the wall clock would mint a new rev every run, and nix keys
# its eval cache on the rev when a `.git` is present.
#
# `add -Af`: the tree is the truth. A caos `--in` carries what the client
# pushed, so honouring the extracted `.gitignore` would drop real content.
phase "git-init the workspace"
if [ ! -d .git ]; then
  git init -q -b main
  phase "git add -Af"
  git add -Af
  phase "committing the workspace"
  GIT_AUTHOR_DATE="@0 +0000" GIT_COMMITTER_DATE="@0 +0000" \
    git -c user.name=caos -c user.email=dev@caos commit -q -m workspace \
    || fail "committing the workspace"
fi
# ---- what this stack is made of --------------------------------------------
# EVERYTHING IS THE CALLER'S, and this runs no `nix` at all. `--inputs` is one
# store path — `.#caos-test-stack-inputs` — carrying the daemons under `bin/`
# and the worker images under `images/`, so ONE evaluation of the flake produces
# the lot. It used to say the first half of that and then evaluate the flake
# three more times for the images, which was 12 seconds of a 16-second bring-up
# against ~1 second to actually start the stack.
#
# TEST world, not host: a dev stack is `.#caos-test-stack-inputs`, so a host
# client is refused by it and vice versa (rust/crates/caos-world). It shares
# every dependency with the host build — only the thin workspace compile
# differs. The worker IMAGES are world-neutral userland (no caos binary is baked
# in; build-builtins composes one on from `CAOS_BUILTIN_BINS`), which is why one
# set of images serves both.
phase "checking the stack binaries"
echo "==> using the stack inputs at $inputs" >&2
for b in server runnerd core-seeder-runner caos-cli caos; do
  [ -x "$inputs/bin/$b" ] || fail "no $b in $inputs/bin"
done

# THE CACHE NAMESPACE IS THE BUILD'S OWN IDENTITY, and it is why several dev
# stacks can share one redis without answering each other's questions. A nix out
# path is INPUT-addressed, so it holds still across rebuilds of an unchanged tree
# whether or not cargo emitted identical bytes — which is exactly the stability
# design/faster-tests.md could not get from hashing built artifacts, and still
# records as unresolved.
#
# It also closes the staleness CLAUDE.md documents from the other direction: a
# rebuilt `caos` leaves a seeded sentinel's ArgTree unmoved, so redis would hand
# back the previous deploy's worker image. A different build is a different
# namespace, so it cannot.
namespace=$(basename "$inputs")
namespace=${namespace%%-*}

# ---- this stack's own engine -----------------------------------------------
# A PODMAN OF OUR OWN, not the host's through a socket. That is what lets this
# script go back to the address every other placement uses: workers run with
# `--network=host`, which inside this container means THIS container's netns, so
# a worker reaches its own server at 127.0.0.1 — the uniformity stack/serve's
# header describes ("every placement puts the group in one netns, so there is no
# address to negotiate"). No IP has to be discovered, advertised, or carried.
#
# It also drops the engine-socket grant entirely: this stack's containers are
# invisible to the host engine, so there are no siblings to collide with, no
# netns dependents blocking their parent's removal, and nothing of ours left
# behind on the host if we die badly.
#
# The image ships the storage and cgroup config (dev/test-stack/flake.nix), so
# there is nothing to construct here — runnerd just needs to be told which
# binary and where its store lives. The store is a granted volume so images
# survive the container; otherwise every run would re-pull std.
engine_store=/caos-images
mkdir -p "$engine_store/store" "$engine_store/run"
command -v podman >/dev/null 2>&1 || fail "no podman in this image"
[ -e /dev/fuse ] || fail "no /dev/fuse — the image must declare CAOS_GRANT_DEVICES"

# ---- keep the pack count under gix's slot limit -----------------------------
# A SHARED, PERSISTENT REPO ACCUMULATES ONE PACK PER PUSH, and gix's object
# store has a fixed number of slots. At 33 packs the server started answering
# `reading arg tree: object <oid> not found: The slotmap turned out to be too
# small with 32 entries, would need 1 more` — which reads as a missing object
# and is really a full table. Measured, not predicted: the count was 33.
#
# `-k` IS LOAD-BEARING. GC is off in a caos repo precisely because almost every
# object is unreachable from any ref (SPEC), so a repack that dropped unreachable
# objects would delete most of the store. `-a -d -k` consolidates into one pack
# and keeps everything.
#
# Only when it is worth doing: repacking 288 MB on every bring-up would be a
# tax on a step that is otherwise seconds.
phase "counting packs"
if [ -d "$state/git/objects/pack" ]; then
  packs=$(find "$state/git/objects/pack" -name '*.pack' | wc -l)
else
  packs=0
fi
if [ "$packs" -gt 16 ]; then
  echo "==> repacking the dev repo ($packs packs)" >&2
  git -C "$state/git" repack -adkq || fail "repacking the dev repo"
fi

# ---- serve -----------------------------------------------------------------
#
# NO COMMENTS INSIDE THE BLOCK BELOW. Every line ends in a backslash, and a
# continuation followed by a comment joins INTO the comment — the env prefix is
# severed and serve runs with none of it. Not a parse error, so `bash -n` passes
# and it surfaces as a stack dying at bring-up over a variable that is right
# there in the source (CLAUDE.md).
phase "starting serve"
ready=$run/stack.ready
rm -f "$ready"
echo "==> starting the dev stack $instance (namespace $namespace)" >&2
echo "==> logs $run/logs, engine $engine_store" >&2
CAOS_STACK_STATE="$state" \
CAOS_STACK_LOGS="$run/logs" \
CAOS_STACK_READY="$ready" \
CAOS_STACK_BIN="$inputs/bin" \
CAOS_STACK_PUBLISH=yes \
CAOS_STACK_PUBLISH_SCRIPT="$PWD/stack/build-builtins.sh" \
CAOS_REGISTRY_HTTP="${CAOS_DEV_REGISTRY:-caos-registry:5000}" \
CAOS_CLI="$inputs/bin/caos-cli" \
CAOS_CLIENT_REPO="$run/publish-client-repo" \
CAOS_BUILTIN_IMAGES="$(echo "$inputs"/images/*)" \
CAOS_BUILTIN_BINS="$inputs" \
CAOS_STACK_REDIS=no \
CAOS_STACK_REDIS_ADDR="${CAOS_DEV_REDIS_ADDR:-caos-redis:6379}" \
CAOS_STACK_REDIS_PORT=6379 \
CAOS_STACK_REDIS_PERSIST=no \
CAOS_STACK_REGISTRY=no \
CAOS_STACK_RUNNERD=yes \
CAOS_STACK_SEEDER=yes \
CAOS_CACHE_NAMESPACE="$namespace" \
CAOS_RUNNER_SLOTS="${CAOS_RUNNER_SLOTS:-48}" \
CAOS_PENDING_TIMEOUT_SECS="${CAOS_PENDING_TIMEOUT_SECS:-900}" \
CAOS_DOCKER_BIN=podman \
CAOS_DOCKER_ARGS="--root $engine_store/store --runroot $engine_store/run" \
CAOS_DOCKER_NETWORK=host \
CAOS_STACK_RUNNER_SERVER_URL=http://127.0.0.1 \
CAOS_REGISTRY_PULL_HOST="${CAOS_DEV_REGISTRY:-caos-registry:5000}" \
CAOS_STACK_RUNNER_REDIS_ADDR="${CAOS_DEV_REDIS_ADDR:-caos-redis:6379}" \
  bash ./stack/serve > "$run/logs/serve.log" 2>&1 &
serve=$!

# serve dies as a group, so its pid is the whole liveness question — which is
# also why this bound can be generous. A dead serve is caught on the next tenth
# of a second, so the timeout is only ever reached by something HUNG, and paying
# a long one costs nothing in the case that actually happens.
#
# GENEROUS BECAUSE READY NOW MEANS PUBLISHED. serve brings the daemons up, runs
# build-builtins and starts the seeder from what it returned, and only then
# touches this file — so this wait covers the std publish, which on a registry
# that lacks this build's clean images is minutes of `skopeo copy`, not the
# second the daemons take. At 60s (what this was, when the publish happened out
# here instead) two concurrent stacks both died "never came up" while both were
# still pushing.
for _ in $(seq 1 18000); do
  if [ -e "$ready" ]; then break; fi
  if ! kill -0 "$serve" 2>/dev/null; then
    cat "$run/logs/serve.log" >&2
    fail "the dev stack died during bring-up"
  fi
  sleep 0.1
done
if [ ! -e "$ready" ]; then
  cat "$run/logs/serve.log" >&2
  tail -20 "$run/logs/publish.log" >&2 2>/dev/null || true
  fail "the dev stack never came up (30 min; the publish above is the slow step)"
fi

# The publish happened INSIDE serve, above — see its `CAOS_STACK_PUBLISH` block.
# This script used to run build-builtins itself, after waiting for the stack,
# and `caosd` had a second copy of the same call for the host. Both are gone:
# the publish and the seeder that consumes its output are two adjacent steps of
# one script now, so the seed tree is a value passed between them instead of a
# ref two stacks could fight over.
#
# CAOS_REGISTRY_BASE_HOST is still deliberately untouched: it is written into
# every delta's `base` blob, so it is DATA, and changing it moves every image
# hash.
#
# The publish client repo is THIS RUN's ($run, above) because build-builtins
# stages this build's seed binaries into it under fixed names — two publishers
# in one repo race over both the index lock and the staged bytes. Its whole job
# is done by the time serve reports ready, and it is the bulk of what a run
# leaves on the volume, so it goes.
rm -rf "$run/publish-client-repo"

# `caos-cli` pushes over a git remote literally named `caos`
# (crates/caos/src/lib.rs, CAOS_REMOTE) and refuses to run without one — the
# same line tests/lib/worker runs for each test's client repo. The
# workspace is a repo the tool made, so nothing has set it up.
if git remote get-url caos >/dev/null 2>&1; then
  git remote set-url caos http://127.0.0.1
else
  git remote add caos http://127.0.0.1
fi

# Where the next command finds a client, as a directory of symlinks: environment
# does not survive back to the caller, which is a separate process under the
# same shell. `/caos-run` is the fixed name, and it is fixed per CONTAINER (the
# symlink planted at the top of this script), not per host — the caller is in
# here with us, and the stack next door has a client of its own.
phase "done"
ln -sfn "$inputs/bin" "$run/bin"
echo "==> dev stack ready (client: /caos-run/bin/caos-cli)" >&2
grep -h "caos-runnerd:" "$run"/logs/runnerd.log 1>&2 2>/dev/null || true
